// Colours and table cells shared by the pages.

import { Palette, ScrollView } from "std-widgets.slint";

export global Theme {
    // 0 dark, 1 light, 2 classic (the 2017 Steam skin's warm greys): the launcher setting "theme"
    // (Settings > General > Appearance). Each colour below is "light ? … : classic ? … : dark".
    in-out property <int> scheme: 0;
    out property <bool> light: scheme == 1;
    out property <bool> classic: scheme == 2;

    // 0 unknown, 1 in game, 2 main menu, 3 logo, 4 doesn't boot
    public pure function status-color(code: int) -> color {
        return code == 1 ? #30a46c : code == 2 ? #3a86ff : code == 3 ? #f5a524 : code == 4 ? #e5484d : #565f70;
    }
    // A see-through wash over whatever is behind: white on the dark themes, black on the light one.
    public pure function tint(alpha: float) -> color {
        return (root.light ? #000000 : #ffffff).with-alpha(alpha);
    }
    out property <color> row-hover: light ? #0000000d : classic ? #ffffff0f : #ffffff0f;
    out property <color> row-selected: light ? #00000017 : classic ? #3e5470cc : #ffffff1a;
    out property <color> row-outline: light ? #1a2130b3 : classic ? #d6d6d6aa : #e7ecf3cc;
    out property <color> card-glass: light ? #ffffffc8 : classic ? #1e1d1bc0 : #11141ab8;
    out property <color> bg: light ? #eef1f5 : classic ? #2b2a28 : #0a0c10;
    out property <color> panel: light ? #e6eaf0 : classic ? #232220 : #0d0f14;
    out property <color> card: light ? #ffffff : classic ? #1e1d1b : #11141a;
    out property <color> card-border: light ? #c5ccd8 : classic ? #45433f : #2b3345;
    out property <color> border-hover: light ? #8f9cb2 : classic ? #6a6763 : #3e4c66;
    out property <color> text: light ? #1a2130 : classic ? #d6d6d6 : #d0d7e6;
    out property <color> muted: light ? #586377 : classic ? #8f8f8d : #707b90;
    out property <color> faint: light ? #858fa1 : classic ? #6b6a67 : #565f70;
    out property <color> placeholder: light ? #7d879ab3 : classic ? #6b6a67b3 : #4a5566b3;
    out property <color> accent: light ? #2b6fe0 : classic ? #5a86b8 : #3a86ff;
    out property <color> accent-hover: light ? #4a86ee : classic ? #6f98c6 : #5aa0ff;
    out property <color> accent-pressed: light ? #1f5cc4 : classic ? #4a7099 : #2f74e0;
    out property <color> accent-border-hover: light ? #1f5cc4 : classic ? #8fb0d6 : #6db0ff;
    out property <color> accent-soft: light ? #d4e2fa : classic ? #3a4a5e : #1f3550; // banners, the selected nav row
    out property <color> on-accent: #ffffff; // text and icons on accent or danger fills
    out property <color> text-strong: light ? #000000 : #ffffff; // the picked row in a drop-down list
    out property <color> danger: light ? #d93036 : classic ? #c9453f : #e5484d;
    out property <color> danger-hover: light ? #e5484d : classic ? #db5a54 : #f06065;
    out property <color> log-bg: light ? #ffffff : classic ? #1a1a19 : #07090c; // also the inside of edit boxes and pickers
    out property <color> log-text: light ? #2a3140 : classic ? #c4c4c4 : #b9c4d2;
    out property <color> popup: light ? #ffffff : classic ? #2f2e2c : #141923;
    out property <color> tab-inactive: light ? #dfe4eb : classic ? #262523 : #141820;
    out property <color> control-hover: light ? #e1e6ee : classic ? #3a3936 : #1d212a;
    out property <color> button-top: light ? #ffffff : classic ? #4a4946 : #232834;
    out property <color> button-bottom: light ? #f0f2f6 : classic ? #3c3b38 : #191d26;
    out property <color> button-hover: light ? #e8ecf2 : classic ? #55534f : #262c38;
    out property <color> button-pressed: light ? #dde2ea : classic ? #343331 : #14171d;
    // The title bar's menu titles and window buttons (slint-style/fluent-menu.slint keeps its own copy).
    out property <color> chrome-text: light ? #586377 : #8b939f;
    out property <color> chrome-text-hover: light ? #1a2130 : #ffffff;
    out property <color> scrim: light ? #00000052 : classic ? #000000a6 : #000000a6; // behind dialogs
}

// Put one in each window: points the std widgets (scroll bars, menus, LineEdit) at the same light or
// dark palette as Theme, and hands the menus (slint-style/fluent-menu.slint) the scheme itself.
export component PaletteSync {
    property <int> scheme: Theme.scheme;
    function apply() {
        Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark;
        Palette.launcher-scheme = root.scheme;
    }
    init => { root.apply(); }
    changed scheme => { root.apply(); }
}

export // Which sort arrow a sortable table header shows.
enum SortState { none, ascending, descending }

export // One fixed-width table cell; long text is cut with an ellipsis.
component TextCell inherits HorizontalLayout {
    in property <length> w;
    in property <string> text;
    in property <color> color: Theme.text;
    in property <bool> bold: false;
    in property <TextHorizontalAlignment> align: left; // right for numbers, so their digits line up
    width: root.w;
    padding-left: 8px;
    padding-right: 8px;
    Text {
        horizontal-stretch: 1;
        min-width: 0px;
        text: root.text;
        color: root.color;
        font-size: 13px;
        font-weight: root.bold ? 700 : 400;
        horizontal-alignment: root.align;
        overflow: elide;
        vertical-alignment: center;
    }
}

export // Header cell with a drag grip on its right edge; clicking the label sorts by it.
component HeaderCell inherits Rectangle {
    in property <string> text;
    in-out property <length> w;
    in property <string> tooltip; // shown after hovering for a moment
    in property <bool> sortable: false;
    in property <SortState> sort-state: SortState.none;
    in property <TextHorizontalAlignment> align: left; // matches the column's TextCell
    callback clicked(); // a click on the label; the 6 px resize grip does not count as one
    width: root.w;
    background: head-touch.has-hover && root.sortable ? Theme.row-hover : transparent;
    Text {
        x: 8px;
        width: parent.width - (root.sortable ? 26px : 16px);
        height: parent.height;
        text: root.text;
        color: root.sort-state == SortState.none ? Theme.muted : Theme.text;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: root.align;
        vertical-alignment: center;
        overflow: elide;
    }
    // The sorted column's arrow: up for ascending, down for descending.
    if root.sort-state == SortState.ascending: Path {
        x: parent.width - 18px;
        y: parent.height / 2 - 3px;
        width: 7px;
        height: 6px;
        viewbox-width: 7;
        viewbox-height: 6;
        fill: Theme.text;
        MoveTo { x: 0; y: 6; }
        LineTo { x: 3.5; y: 0; }
        LineTo { x: 7; y: 6; }
    }
    if root.sort-state == SortState.descending: Path {
        x: parent.width - 18px;
        y: parent.height / 2 - 3px;
        width: 7px;
        height: 6px;
        viewbox-width: 7;
        viewbox-height: 6;
        fill: Theme.text;
        MoveTo { x: 0; y: 0; }
        LineTo { x: 7; y: 0; }
        LineTo { x: 3.5; y: 6; }
    }
    head-touch := TouchArea {
        x: 0px;
        width: parent.width - 6px;
        mouse-cursor: root.sortable ? pointer : default;
        clicked => {
            if (root.sortable) {
                root.clicked();
            }
        }
    }
    Rectangle {
        x: parent.width - 1px;
        y: 5px;
        width: 1px;
        height: parent.height - 10px;
        background: grip.has-hover || grip.pressed ? Theme.accent : Theme.card-border;
    }
    grip := TouchArea {
        x: parent.width - 6px;
        width: 6px;
        mouse-cursor: col-resize;
        // The grip moves with the edge, so each move adds the delta since the last one.
        moved => {
            if (self.pressed) {
                root.w = max(40px, root.w + self.mouse-x - self.pressed-x);
            }
        }
    }
    if root.tooltip != "": Tooltip {
        text: @markdown("\{root.tooltip}");
    }
}

// Text field whose example text is dark and see-through (LineEdit's placeholder colour can't be set).
export component ThemedEdit inherits Rectangle {
    in property <string> placeholder;
    in property <image> icon; // optional, shown before the text (a magnifier on search boxes)
    in property <bool> editable: true;
    in property <InputType> input-type: InputType.text; // password hides what is typed
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;
    callback accepted();
    callback edited(string); // the text changed by typing
    min-width: 60px;
    height: 26px;
    border-width: 1px;
    border-radius: 0px;
    border-color: input.has-focus ? Theme.accent : Theme.card-border;
    background: Theme.log-bg;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 13px;
                height: 13px;
                colorize: Theme.muted;
            }
        }
        // Clipped, and the text scrolls to keep the cursor in view (as std-widgets' LineEdit does).
        Rectangle {
            horizontal-stretch: 1;
            min-width: 1px;
            clip: true;
            input := TextInput {
                property <length> computed-x;
                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                width: max(parent.width - self.text-cursor-width, self.preferred-width);
                height: 100%;
                cursor-position-changed(pos) => {
                    if pos.x + self.computed-x < 0px {
                        self.computed-x = -pos.x;
                    } else if pos.x + self.computed-x > parent.width - self.text-cursor-width {
                        self.computed-x = parent.width - pos.x - self.text-cursor-width;
                    }
                }
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                enabled: root.editable;
                input-type: root.input-type;
                accepted => { root.accepted(); }
                edited => { root.edited(self.text); }
            }
            Text {
                visible: input.text == "";
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: Theme.placeholder;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    in property <length> icon-size: 22px;
    in property <string> tooltip; // shown after hovering for a moment
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 0px;
    background: icon-touch.has-hover && root.enabled ? Theme.control-hover : transparent;
    animate background { duration: 100ms; }
    Image {
        source: root.icon;
        colorize: root.enabled ? Theme.text : Theme.faint;
        width: root.icon-size;
        height: root.icon-size;
    }
    icon-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if root.tooltip != "": Tooltip {
        text: @markdown("\{root.tooltip}");
    }
}

// A name edited in place: Enter or clicking away keeps the change, Escape drops it.
export component InlineEdit inherits Rectangle {
    in property <string> text;
    callback done(string);   // the new text, only when it changed
    callback cancelled();
    property <bool> finished: false;
    min-width: 90px;
    background: Theme.log-bg;
    border-width: 1px;
    border-color: Theme.accent;
    border-radius: 0px;
    Rectangle {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        clip: true;
    input := TextInput {
        property <length> computed-x;
        x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
        width: max(parent.width - self.text-cursor-width, self.preferred-width);
        height: 100%;
        cursor-position-changed(pos) => {
            if pos.x + self.computed-x < 0px {
                self.computed-x = -pos.x;
            } else if pos.x + self.computed-x > parent.width - self.text-cursor-width {
                self.computed-x = parent.width - pos.x - self.text-cursor-width;
            }
        }
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        accepted => { root.finish(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.finished = true;
                root.cancelled();
                return accept;
            }
            return reject;
        }
        changed has-focus => {
            if (!self.has-focus) {
                root.finish();
            }
        }
    }
    }
    function finish() {
        if (root.finished) {
            return;
        }
        root.finished = true;
        if (input.text != root.text) {
            root.done(input.text);
        } else {
            root.cancelled();
        }
    }
    init => {
        input.focus();
        input.select-all();
    }
}

// ">" chevron that turns by `angle` (90deg points down). Drawn as a path with its points rotated here,
// because the software renderer ignores rotation-angle on an Image.
export component Chevron inherits Path {
    in property <angle> angle: 0deg;
    in property <color> color: Theme.text;
    viewbox-width: 32;
    viewbox-height: 32;
    stroke: root.color;
    stroke-width: 1.6px;
    stroke-line-cap: round;
    fill: transparent;
    // The icons/chevron-right.svg points (12,7) (21,16) (12,25), turned about the centre (16,16).
    MoveTo {
        x: 16 + (12 - 16) * cos(root.angle) - (7 - 16) * sin(root.angle);
        y: 16 + (12 - 16) * sin(root.angle) + (7 - 16) * cos(root.angle);
    }
    LineTo {
        x: 16 + (21 - 16) * cos(root.angle) - (16 - 16) * sin(root.angle);
        y: 16 + (21 - 16) * sin(root.angle) + (16 - 16) * cos(root.angle);
    }
    LineTo {
        x: 16 + (12 - 16) * cos(root.angle) - (25 - 16) * sin(root.angle);
        y: 16 + (12 - 16) * sin(root.angle) + (25 - 16) * cos(root.angle);
    }
}

// The launcher's drop-down (std ComboBox cannot be made as short as a thin text field, and its Fluent drawing does
// not follow the theme). Click, Enter or Space opens the list; Up/Down change the value while it is closed, and move
// the highlight while it is open (Enter picks, Esc closes). `selected(i)` fires after every pick.
// Set `tracks-selection: false` for an action menu (the Emu column's None / Set Emu…): a pick fires `selected` but
// leaves `current-index` alone and no row is marked, so `text` says what the closed box shows.
export component Dropdown inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <[bool]> item-enabled; // greys out entries; an entry past its end is enabled
    in property <bool> enabled: true;
    in property <bool> compact: false; // 24 px tall with 12 px text, for table cells
    in property <bool> tracks-selection: true;
    in property <string> placeholder; // shown, muted, while nothing is picked
    in property <string> text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
    in property <color> text-color: Theme.text;
    in property <length> popup-width: max(120px, root.width);
    out property <bool> is-open: root.popup-focused;
    out property <bool> has-focus: fs.has-focus || root.popup-focused;
    callback selected(int);
    property <bool> popup-focused; // the open list holds the focus
    property <bool> tab-focused; // the frame only lights up for keyboard focus, not after every click
    property <int> highlight: -1; // the row the arrow keys are on while the list is open
    property <length> row-h: 26px;
    property <int> visible-rows: min(10, root.model.length);

    // Opens the list; for owners whose own TouchArea covers this one (the game list's rows).
    public function open() {
        if (root.enabled && root.model.length > 0) {
            root.highlight = root.tracks-selection ? root.current-index : -1;
            popup.show();
        }
    }
    function close-list() {
        popup.close();
        root.popup-focused = false;
        fs.focus();
    }
    pure function item-on(i: int) -> bool {
        return i < 0 || i >= root.item-enabled.length || root.item-enabled[i];
    }
    function pick(i: int) {
        if (i < 0 || i >= root.model.length || !root.item-on(i)) {
            return;
        }
        if (root.tracks-selection) {
            root.current-index = i;
        }
        root.selected(i);
    }

    height: root.compact ? 24px : 26px;
    min-width: root.compact ? 40px : 90px;
    background: Theme.log-bg;
    border-width: 1px;
    border-radius: 0px;
    border-color: !root.enabled ? Theme.card-border
        : root.is-open || (root.tab-focused && fs.has-focus) || touch.has-hover ? Theme.accent : Theme.card-border;
    opacity: root.enabled ? 1 : 0.45;
    forward-focus: fs;
    accessible-role: combobox;
    accessible-value: root.text;
    accessible-expanded: root.is-open;

    fs := FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation) {
                root.tab-focused = true;
            } else if (reason == FocusReason.pointer-click) {
                root.tab-focused = false;
            }
        }
        focus-lost(reason) => {
            if (reason != FocusReason.popup-activation) {
                root.tab-focused = false;
            }
        }
        changed has-focus => {
            // The focus comes back here when the list closes, however it was closed.
            if (self.has-focus) {
                root.popup-focused = false;
            }
        }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.open();
                return accept;
            }
            if (root.tracks-selection && event.text == Key.UpArrow) {
                root.pick(max(0, root.current-index - 1));
                return accept;
            }
            if (root.tracks-selection && event.text == Key.DownArrow) {
                root.pick(min(root.model.length - 1, root.current-index + 1));
                return accept;
            }
            return reject;
        }
        HorizontalLayout {
            padding-left: root.compact ? 8px : 10px;
            padding-right: root.compact ? 6px : 8px;
            spacing: root.compact ? 4px : 6px;
            Text {
                horizontal-stretch: 1;
                text: root.text != "" ? root.text : root.placeholder;
                color: root.text != "" ? root.text-color : Theme.muted;
                font-size: root.compact ? 12px : 13px;
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                Chevron {
                    color: root.is-open ? Theme.text : Theme.muted;
                    width: root.compact ? 10px : 12px;
                    height: self.width;
                    angle: root.is-open ? -90deg : 90deg;
                }
            }
        }
        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.open(); }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: root.popup-width;
        height: root.visible-rows * root.row-h + 8px;
        close-policy: close-on-click-outside;
        forward-focus: list-fs;
        list-fs := FocusScope {
            focus-changed-event => { root.popup-focused = self.has-focus; }
            init => {
                // Long lists open scrolled so the current row sits near the middle.
                list-scroll.content-y = -clamp((root.highlight - (root.visible-rows - 1) / 2) * root.row-h, 0px,
                    max(0px, (root.model.length - root.visible-rows) * root.row-h));
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close-list();
                    return accept;
                }
                if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                    root.highlight = event.text == Key.UpArrow ? max(0, root.highlight - 1)
                        : min(root.model.length - 1, root.highlight + 1);
                    // Keep the highlighted row in view.
                    if (root.highlight * root.row-h < -list-scroll.content-y) {
                        list-scroll.content-y = -root.highlight * root.row-h;
                    } else if ((root.highlight + 1) * root.row-h > -list-scroll.content-y + root.visible-rows * root.row-h) {
                        list-scroll.content-y = -((root.highlight + 1 - root.visible-rows) * root.row-h);
                    }
                    return accept;
                }
                if (event.text == Key.Return || event.text == " ") {
                    if (root.item-on(root.highlight)) {
                        root.close-list();
                        root.pick(root.highlight);
                    }
                    return accept;
                }
                return reject;
            }
            Rectangle {
                background: Theme.popup;
                border-width: 1px;
                border-color: Theme.card-border;
                border-radius: 0px;
                clip: true;
                list-scroll := ScrollView {
                    x: 1px;
                    y: 4px;
                    width: parent.width - 2px;
                    height: root.visible-rows * root.row-h;
                    content-width: self.visible-width;
                    VerticalLayout {
                        width: list-scroll.visible-width;
                        for item[i] in root.model: row := Rectangle {
                            property <bool> on: root.item-on(i);
                            property <bool> current: root.tracks-selection && i == root.current-index;
                            height: root.row-h;
                            background: !self.on ? transparent
                                : item-touch.has-hover || i == root.highlight ? Theme.row-hover
                                : self.current ? Theme.tint(0.03) : transparent;
                            // The current value's marker.
                            if row.current: Rectangle {
                                x: 0px;
                                width: 2px;
                                height: parent.height;
                                background: Theme.accent;
                            }
                            Text {
                                x: 10px;
                                width: parent.width - 18px;
                                text: item;
                                color: !row.on ? Theme.faint : row.current ? Theme.text-strong : Theme.text;
                                font-size: 13px;
                                font-weight: row.current ? 600 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            item-touch := TouchArea {
                                enabled: row.on;
                                mouse-cursor: row.on ? pointer : default;
                                // Pick before closing: closing the popup destroys this row, and `i` with it.
                                clicked => {
                                    root.pick(i);
                                    root.close-list();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// A titled group: a thin frame with its title sitting on the top edge. `hint` is what the title explains in the
// description panel when the pointer is over it.
export component Card inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    padding-top: 8px; // room for the title, which rises above the frame
    Rectangle {
        border-width: 1px;
        border-color: Theme.card-border;
        border-radius: 0px;
        VerticalLayout {
            padding: 10px;
            padding-top: 15px;
            spacing: 6px;
            alignment: start;
            @children
        }
        // The title covers the border behind it.
        Rectangle {
            x: 10px;
            y: -8px;
            width: title-text.preferred-width + 8px;
            height: 16px;
            background: Theme.panel;
            title-text := Text {
                x: 4px;
                width: self.preferred-width;
                height: parent.height;
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
            }
            if root.hint != "": Tooltip {
                text: @markdown("\{root.hint}");
            }
        }
    }
}

// ---- Controls in the launcher's own style: square, 1 px borders, the reference's shading. They replace the
// std-widgets ones, whose Fluent drawing (rounded corners, its own palette) does not follow the theme. ----

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 28px;
    min-width: 76px;
    border-width: 1px;
    border-radius: 0px;
    border-color: root.primary ? (touch.has-hover ? Theme.accent-border-hover : Theme.accent)
        : touch.has-hover ? Theme.border-hover : Theme.card-border;
    background: root.primary
        ? (touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : touch.pressed ? Theme.button-pressed : touch.has-hover ? Theme.button-hover : @linear-gradient(180deg, Theme.button-top 0%, Theme.button-bottom 100%);
    opacity: root.enabled ? 1 : 0.45;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 14px;
                height: 14px;
                colorize: root.primary ? Theme.on-accent : Theme.text;
            }
        }
        Text {
            text: root.text;
            color: root.primary ? Theme.on-accent : Theme.text;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

// Top of a full page (Version Manager, Controls, Trophies): the way back to the library, the page
// title, any page-wide controls on the right (the children), and a hairline under it all that runs
// out to the window edges. Back button first: a control after growing content gets pushed
// off-screen, the leading position is immune.
export component PageHeader inherits Rectangle {
    in property <string> title;
    in property <string> back-text: "← Library";
    in property <length> bleed: 24px; // the page's side padding: the hairline reaches past it to the edges
    callback back();
    height: 44px;
    HorizontalLayout {
        padding-bottom: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            AppButton {
                width: 110px;
                text: root.back-text;
                clicked => { root.back(); }
            }
        }
        // Takes the free width, so the children pack against the right edge; a long title is cut.
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.title;
            color: Theme.text;
            font-size: 20px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        @children
    }
    Rectangle {
        x: -root.bleed;
        y: root.height - 1px;
        width: root.width + 2 * root.bleed;
        height: 1px;
        background: Theme.card-border;
    }
}

export component AppCheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: 24px;
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 14px;
                height: 14px;
                border-width: 1px;
                border-radius: 0px;
                border-color: root.checked ? Theme.accent : check-touch.has-hover ? Theme.border-hover : Theme.card-border;
                background: root.checked ? Theme.accent : Theme.log-bg;
                Text {
                    text: "✓";
                    color: Theme.on-accent;
                    font-size: 9px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    visible: root.checked;
                }
            }
        }
        Text {
            text: root.text;
            color: root.enabled ? Theme.text : Theme.faint;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    check-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}

export component AppSlider inherits Rectangle {
    in-out property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 0;
    in property <bool> enabled: true;
    callback changed(float);
    height: 24px;
    min-width: 60px;
    // Where a pointer at `x` puts the value: clamped to the range and snapped to `step`.
    pure function value-at(x: length) -> float {
        return root.maximum > root.minimum
            ? root.minimum + clamp(0.0, 1.0, (x - thumb-w / 2) / max(1px, root.width - thumb-w)) * (root.maximum - root.minimum)
            : root.minimum;
    }
    function snapped(v: float) -> float {
        return root.step > 0 ? round(v / root.step) * root.step : v;
    }
    pure function ratio() -> float {
        return root.maximum > root.minimum ? (root.value - root.minimum) / (root.maximum - root.minimum) : 0;
    }
    property <length> thumb-w: 10px;
    opacity: root.enabled ? 1 : 0.45;
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: 1px;
        background: Theme.card-border;
    }
    Rectangle {
        x: root.ratio() * (parent.width - thumb-w);
        y: (parent.height - self.height) / 2;
        width: thumb-w;
        height: 14px;
        background: slider-touch.pressed ? Theme.accent-hover : slider-touch.has-hover ? Theme.accent-hover : Theme.accent;
    }
    slider-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        moved => {
            // Drags only: an unguarded `moved` retunes the value on plain hover.
            if (self.pressed) {
                root.value = root.snapped(root.value-at(self.mouse-x));
                root.changed(root.value);
            }
        }
        clicked => {
            root.value = root.snapped(root.value-at(self.mouse-x));
            root.changed(root.value);
        }
    }
}

export component AppSpinBox inherits Rectangle {
    in-out property <int> value: 0;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <bool> enabled: true;
    height: 26px;
    min-width: 78px;
    border-width: 1px;
    border-radius: 0px;
    border-color: Theme.card-border;
    background: Theme.log-bg;
    opacity: root.enabled ? 1 : 0.45;
    function bump(by: int) {
        root.value = max(root.minimum, min(root.maximum, root.value + by));
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 2px;
        spacing: 6px;
        Text {
            horizontal-stretch: 1;
            text: root.value;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Rectangle {
                width: 18px;
                height: 11px;
                background: up-touch.has-hover ? Theme.row-hover : transparent;
                Chevron {
                    x: 5px;
                    y: 2px;
                    width: 8px;
                    height: 8px;
                    angle: 270deg;
                    color: Theme.muted;
                }
                up-touch := TouchArea {
                    enabled: root.enabled && root.value < root.maximum;
                    mouse-cursor: pointer;
                    clicked => { root.bump(1); }
                }
            }
            Rectangle {
                width: 18px;
                height: 11px;
                background: down-touch.has-hover ? Theme.row-hover : transparent;
                Chevron {
                    x: 5px;
                    y: 1px;
                    width: 8px;
                    height: 8px;
                    angle: 90deg;
                    color: Theme.muted;
                }
                down-touch := TouchArea {
                    enabled: root.enabled && root.value > root.minimum;
                    mouse-cursor: pointer;
                    clicked => { root.bump(-1); }
                }
            }
        }
    }
}
