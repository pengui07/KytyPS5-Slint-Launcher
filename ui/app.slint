import { Button, ComboBox, LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { Theme, TextCell, HeaderCell, IconButton } from "common.slint";
import { VM, EmuVersion, ReleaseItem, VersionManagerPage } from "version_manager.slint";
import { SettingsPage, GameConfigRow, BuildChoice } from "settings.slint";
import { Trophies, TrophyGame, TrophyItem, TrophiesPage } from "trophies.slint";

// The generated C++ header needs these.
export { VM, EmuVersion, ReleaseItem, Trophies, TrophyGame, TrophyItem, GameConfigRow, BuildChoice }

export struct GameRow {
    name: string,
    serial: string,
    game-version: string,
    firmware: string,
    size: string,
    path: string,
    status: string,
    status-code: int,
    comment: string,
    play-time: string, // e.g. "12h 30m"; empty until play time is tracked
    icon: image,
}

// Column widths; the header grips resize them and every row follows.
export global Cols {
    in-out property <length> name: 240px;
    in-out property <length> serial: 100px;
    in-out property <length> version: 110px;
    in-out property <length> firmware: 120px;
    in-out property <length> size: 80px;
    in-out property <length> path: 260px;
    in-out property <length> status: 120px;
    in-out property <length> comment: 300px;
    in-out property <length> playtime: 100px;
    // Space between the box edge and the first/last column; header strip and rows still run edge to edge.
    out property <length> inset: 10px;
    out property <length> total: self.inset * 2 + self.name + self.serial + self.version + self.firmware + self.size + self.path + self.status + self.comment + self.playtime;
}

component TableHeader inherits HorizontalLayout {
    height: 28px;
    spacing: 0px;
    padding-left: Cols.inset;
    padding-right: Cols.inset;
    HeaderCell { text: "Game"; w <=> Cols.name; }
    HeaderCell { text: "Status"; w <=> Cols.status; }
    HeaderCell { text: "Serial"; w <=> Cols.serial; }
    HeaderCell { text: "Firmware"; w <=> Cols.firmware; }
    HeaderCell { text: "Size"; w <=> Cols.size; }
    HeaderCell { text: "Game Version"; w <=> Cols.version; }
    HeaderCell { text: "Play Time"; w <=> Cols.playtime; }
    HeaderCell { text: "Path"; w <=> Cols.path; }
    HeaderCell { text: "Comments"; w <=> Cols.comment; }
}

component GameRowView inherits Rectangle {
    in property <GameRow> game;
    in property <bool> selected;
    callback clicked();
    callback double-clicked();
    callback menu(length, length); // right-click, in window coordinates
    height: 46px;
    background: root.selected ? Theme.row-selected : touch.has-hover ? Theme.row-hover : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.row-outline;

    HorizontalLayout {
        spacing: 0px;
        padding-left: Cols.inset;
        padding-right: Cols.inset;
        HorizontalLayout {
            width: Cols.name;
            padding-left: 6px;
            padding-right: 8px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    background: Theme.log-bg;
                    clip: true;
                    Image {
                        source: root.game.icon;
                        image-fit: cover;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: root.game.name;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            width: Cols.status;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 7px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Theme.status-color(root.game.status-code);
                }
            }
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: root.game.status;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        TextCell { w: Cols.serial; text: root.game.serial; }
        TextCell { w: Cols.firmware; text: root.game.firmware == "" ? "—" : root.game.firmware; }
        TextCell { w: Cols.size; text: root.game.size; }
        TextCell { w: Cols.version; text: root.game.game-version == "" ? "—" : root.game.game-version; }
        TextCell { w: Cols.playtime; text: root.game.play-time == "" ? "—" : root.game.play-time; }
        TextCell { w: Cols.path; text: root.game.path; }
        TextCell { w: Cols.comment; text: root.game.comment; color: Theme.muted; }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.clicked();
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// Search field with a magnifier icon; filtering is not wired up yet.
component SearchBox inherits Rectangle {
    in-out property <string> text <=> input.text;
    public function unfocus() { input.clear-focus(); }
    height: 34px;
    border-radius: 4px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.card-border;
    background: #ffffff0a;
    // Clicks anywhere in the box (icon, padding) focus the text; the input on top still
    // gets its own clicks for cursor placement.
    TouchArea {
        mouse-cursor: MouseCursor.text; // plain `text` would mean the box's text property
        clicked => { input.focus(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        // The clear button runs to the border, so drop the right padding while it shows.
        padding-right: input.text != "" ? 1px : 10px;
        padding-top: 1px;
        padding-bottom: 1px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/search.svg");
                colorize: Theme.muted;
                width: 16px;
                height: 16px;
            }
        }
        // Long text must not widen the box: clip it and slide it so the cursor stays
        // visible (the same scheme as std-widgets' LineEdit). clip needs a Rectangle.
        Rectangle {
            horizontal-stretch: 1;
            min-width: 1px;
            preferred-width: 0px;
            clip: true;
            // Escape leaves the field (keys the input doesn't use bubble up to here).
            FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        input.clear-focus();
                        return accept;
                    }
                    return reject;
                }
                input := TextInput {
                    property <length> computed-x;
                    x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                    width: max(parent.width - self.text-cursor-width, self.preferred-width);
                    height: 100%;
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                    single-line: true;
                    cursor-position-changed(pos) => {
                        if (pos.x + self.computed-x < 0px) {
                            self.computed-x = -pos.x;
                        } else if (pos.x + self.computed-x > parent.width - self.text-cursor-width) {
                            self.computed-x = parent.width - pos.x - self.text-cursor-width;
                        }
                    }
                }
                Text {
                    overflow: elide;
                    visible: input.text == "";
                    width: 100%;
                    height: 100%;
                    text: "Search name or serial";
                    color: Theme.faint;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }
        // Clear button, shown once something is typed (like Steam's).
        // It fills the whole right end of the box (inside the 1px border).
        if input.text != "": Rectangle {
            width: 32px;
            border-top-right-radius: 3px;
            border-bottom-right-radius: 3px;
            background: clear-touch.has-hover ? #ffffff1a : transparent;
            Image {
                source: @image-url("icons/clear.svg");
                colorize: clear-touch.has-hover ? Theme.text : Theme.muted;
                width: 14px;
                height: 14px;
            }
            clear-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    input.text = "";
                    input.focus();
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "KytyPS5 Launcher";
    icon: @image-url("icons/app-icon.png");
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 1000px;
    min-height: 560px;
    background: Theme.bg;
    default-font-size: 13px;

    in-out property <string> emulator;
    in-out property <string> game;
    in-out property <string> run-dir;
    in-out property <string> game-dirs;
    in property <[string]> game-dir-list; // game-dirs split, for the Game folders list
    in-out property <int> game-dir-selected: -1;
    callback remove-game-dir(int);
    in-out property <bool> show-settings: false;
    in-out property <bool> show-versions: false;
    changed show-versions => {
        if (!self.show-versions) {
            VM.closed();
        }
    }
    in-out property <bool> show-trophies: false;
    // Settings page in per-game mode (the C++ side loads the game's values into the properties below).
    in property <bool> game-mode;
    in property <string> game-mode-name;
    in property <string> game-mode-serial;
    in property <bool> game-mode-from-library; // opened from the library menu: Back returns there
    // Games tab of Settings, one row per library game, and the "Set Emu..." picker.
    in property <[GameConfigRow]> game-configs;
    in property <[BuildChoice]> pin-builds; // every installed build, unfiltered
    in-out property <bool> pin-dialog-open;
    in-out property <int> pin-dialog-row: -1;
    in-out property <int> pin-pick: -1;
    callback games-opened();
    callback open-game-settings(int, bool); // library index, from the library's menu
    callback leave-game-settings();
    callback reset-game-settings();
    callback set-game-emu(int, int);        // library index, index in pin-builds (-1: None)
    changed show-settings => {
        // Leaving the page by any way (menu, toolbar) also leaves per-game mode.
        if (!self.show-settings && self.game-mode) {
            root.leave-game-settings();
        }
    }
    in-out property <int> settings-tab: 0;
    in-out property <int> selected: -1;
    in property <[GameRow]> games;
    in property <bool> scanning;
    in property <int> recommended-size: -1; // the Window size preset that matches the monitor
    in-out property <string> width-text;
    in-out property <string> height-text;
    in-out property <string> extra-args;
    in-out property <int> present-mode: 1;
    in-out property <string> vblank-text: "60";
    in-out property <int> shader-opt: 0;
    in-out property <string> gpu-text;
    in-out property <bool> readback;
    in-out property <bool> readback-tiled;
    in-out property <bool> tessellation;
    in-out property <bool> sync-raw;
    in-out property <bool> hdr;
    in-out property <bool> vulkan-validation;
    in-out property <bool> shader-validation;
    in-out property <bool> renderdoc;
    in-out property <bool> cmd-dump;
    in-out property <bool> profiler;
    in-out property <int> shader-log: 0;
    in-out property <int> printf-dir: 0;
    in-out property <string> printf-file;
    in-out property <string> shader-log-folder;
    in-out property <string> cmd-dump-folder;
    in-out property <string> user-name;
    in-out property <string> user-id-text;
    in-out property <int> console-language: 1;
    in-out property <string> microphone;
    in-out property <bool> amd-cpu;
    in-out property <bool> red-zone;
    in-out property <bool> trophy: true;
    in-out property <int> trophy-duration: 6;
    in-out property <bool> fullscreen;
    in-out property <bool> hide-cursor;
    in-out property <bool> perf-panel;
    in-out property <bool> skip-boot-logos;
    in-out property <bool> network-connected;
    in-out property <string> controller-color; // "#rrggbb", empty = the default lightbar
    in property <color> controller-swatch; // controller-color as a colour, set by the C++ side
    in-out property <float> controller-vibration: 100;
    in-out property <float> controller-volume: 50;
    in-out property <int> keyboard-player: 0;
    in-out property <string> addons-dir;
    in property <bool> running;
    in property <string> running-name; // the game that is running
    in property <bool> is-windows: false; // Windows-only options are hidden elsewhere
    in-out property <bool> close-prompt-open; // closing the window while a game runs
    in-out property <bool> delete-cache-prompt-open; // Settings > Versions > Delete cache
    in-out property <bool> import-summary-open; // the Kyty.ini import finished: shows import-summary-text once
    in property <string> import-summary-text;
    callback confirm-close();
    in property <string> status;

    callback browse-emulator();
    callback browse-game();
    callback browse-run-dir();
    callback browse-game-dir();
    callback browse-addons-dir();
    callback import-kyty-ini(); // Settings > Paths > Import from Kyty.ini...
    callback controller-color-edited(string);
    callback select-game(int);
    callback play-game(int);
    callback refresh-library();
    callback add-game();
    callback remove-game();
    callback open-game-trophies(int); // library index: the Trophies page on that game
    callback open-save-folder(int); // <run folder>\_SaveData\<serial>
    callback play();
    callback stop();
    callback dry-run();
    callback save();
    callback discard-settings(); // Settings > Discard: put back the saved values
    callback open-url(string);
    callback open-console();

    // Opens the settings page on a tab (from the Settings menu).
    public function open-settings(tab: int) {
        root.settings-tab = tab;
        root.show-versions = false;
        root.show-trophies = false;
                        root.show-settings = true;
    }
    in property <[string]> emu-builds;
    in-out property <int> emu-build-index: -1;
    callback choose-emu-build(int);

    // The selected game's art: two layers that crossfade.
    property <image> bg-a;
    property <image> bg-b;
    property <bool> bg-show-b: false;
    public function set-background(img: image) {
        if (root.bg-show-b) {
            root.bg-a = img;
        } else {
            root.bg-b = img;
        }
        root.bg-show-b = !root.bg-show-b;
    }

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Add game…";
                activated => { root.add-game(); }
            }
            MenuItem {
                title: "Run folder";
                enabled: root.run-dir != "";
                activated => { root.open-url(root.run-dir); }
            }
        }
        Menu {
            title: "View";
            Menu {
                title: "Page";
                MenuItem {
                    title: "Library";
                    activated => {
                        root.show-settings = false;
                        root.show-versions = false;
                    }
                }
                MenuItem {
                    title: "Settings";
                    activated => {
                        root.show-versions = false;
                        root.show-trophies = false;
                        root.show-settings = true;
                    }
                }
                MenuItem {
                    title: "Version Manager";
                    activated => {
                        root.show-settings = false;
                        root.show-trophies = false;
                        root.show-versions = true;
                        VM.opened();
                    }
                }
            }
            MenuItem {
                title: "Console";
                activated => { root.open-console(); }
            }
        }
        Menu {
            title: "Settings";
            MenuItem {
                title: "General";
                activated => { root.open-settings(0); }
            }
            MenuItem {
                title: "Graphics";
                activated => { root.open-settings(1); }
            }
            MenuItem {
                title: "Advanced";
                activated => { root.open-settings(2); }
            }
            MenuItem {
                title: "Debug";
                activated => { root.open-settings(3); }
            }
            MenuItem {
                title: "Games";
                activated => { root.open-settings(4); }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "GitHub";
                activated => { root.open-url("https://github.com/KytyPS5/KytyPS5"); }
            }
            MenuItem {
                title: "Check for updates";
                enabled: false; // placeholder
            }
        }
    }

    // Right-click menu of the selected game (the row selects itself first). It belongs to the
    // window itself: while a menu is open Slint hands the next click to the menu's parent, so a
    // right-click on another row then still reaches that row, in window coordinates.
    // Zero-sized, so a right-click elsewhere opens nothing.
    game-menu := ContextMenuArea {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        Menu {
            MenuItem {
                title: "Run";
                enabled: !root.running && root.selected >= 0;
                activated => { root.play-game(root.selected); }
            }
            MenuItem {
                title: "Trophies";
                activated => {
                    root.show-settings = false;
                    root.show-versions = false;
                    root.show-trophies = true;
                    root.open-game-trophies(root.selected);
                }
            }
            MenuItem {
                title: "Open save folder";
                activated => { root.open-save-folder(root.selected); }
            }
            MenuItem {
                title: "Game settings…";
                enabled: root.selected >= 0 && root.selected < root.games.length && root.games[root.selected].serial != "";
                activated => {
                    root.show-versions = false;
                    root.show-trophies = false;
                    root.show-settings = true;
                    root.open-game-settings(root.selected, true);
                }
            }
            MenuItem {
                title: "Open game folder";
                activated => {
                    if (root.selected >= 0 && root.selected < root.games.length) {
                        root.open-url(root.games[root.selected].path);
                    }
                }
            }
            MenuItem {
                title: "Remove from list";
                enabled: !root.running;
                activated => { root.remove-game(); }
            }
        }
    }

    // Clicking empty space only drops focus from the search box; the game selection stays.
    TouchArea {
        visible: !root.show-settings && !root.show-versions && !root.show-trophies;
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clicked => {
            search.unfocus();
        }
    }

    // Home: the game library.
    VerticalLayout {
        visible: !root.show-settings && !root.show-versions && !root.show-trophies;
        padding: 18px;
        padding-left: 24px;
        padding-right: 24px;
        spacing: 14px;

        // The bar behind the toolbar buttons.
        Rectangle {
            height: 48px;
            background: Theme.card;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.card-border;
            HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 4px;
            // One button: play when nothing runs, stop while the game runs.
            IconButton {
                icon: root.running ? @image-url("icons/stop.svg") : @image-url("icons/play.svg");
                enabled: root.running || (root.selected >= 0 && root.selected < root.games.length);
                clicked => {
                    if (root.running) {
                        root.stop();
                    } else {
                        root.play-game(root.selected);
                    }
                }
            }
            IconButton {
                icon: @image-url("icons/global-settings.svg");
                clicked => { root.show-trophies = false;
                        root.show-settings = true; }
            }
            IconButton {
                icon: @image-url("icons/remove-configuration.svg");
                enabled: !root.running && root.selected >= 0 && root.selected < root.games.length;
                clicked => { root.remove-game(); }
            }
            IconButton { icon: @image-url("icons/input-mapping.svg"); enabled: false; }
            IconButton {
                icon: @image-url("icons/trophy.svg");
                clicked => {
                    root.show-trophies = true;
                    Trophies.detail-open = false;
                    Trophies.opened();
                }
            }
            VerticalLayout {
                alignment: center;
                search := SearchBox { width: 240px; }
            }
            IconButton {
                icon: @image-url("icons/refresh.svg");
                enabled: !root.scanning;
                clicked => { root.refresh-library(); }
            }
            Rectangle { horizontal-stretch: 1; }
            IconButton { icon: @image-url("icons/grid-view.svg"); enabled: false; }
            // Which emulator build runs the game (the Version Manager's installed list).
            VerticalLayout {
                alignment: center;
                ComboBox {
                    width: 230px;
                    model: root.emu-builds;
                    current-index <=> root.emu-build-index;
                    selected => { root.choose-emu-build(self.current-index); }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Version Manager";
                    clicked => {
                        root.show-trophies = false;
                        root.show-versions = true;
                        VM.opened();
                    }
                }
            }
            }
        }

        // The library table; the selected game's art sits inside it, behind the rows.
        library-box := Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;
            border-radius: 3px;
            border-width: 1px;
            border-color: Theme.card-border;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.bg-a;
                image-fit: cover;
                opacity: root.bg-show-b ? 0 : 1;
                animate opacity { duration: 350ms; easing: ease-in-out; }
            }
            Image {
                width: parent.width;
                height: parent.height;
                source: root.bg-b;
                image-fit: cover;
                opacity: root.bg-show-b ? 1 : 0;
                animate opacity { duration: 350ms; easing: ease-in-out; }
            }
            Rectangle { background: Theme.bg.with-alpha(0.68); }

            VerticalLayout {
                padding: 1px;
                // The header follows the rows' horizontal scroll.
                Rectangle {
                    height: 28px;
                    background: #0b0e14d9;
                    clip: true;
                    TableHeader {
                        x: table.content-x;
                        width: Cols.total;
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.card-border;
                    }
                }
                table := ListView {
                    vertical-stretch: 1;
                    content-width: max(self.visible-width, Cols.total);
                    for game[index] in root.games: GameRowView {
                        width: Cols.total;
                        game: game;
                        selected: index == root.selected;
                        clicked => {
                            search.unfocus();
                            root.select-game(index);
                        }
                        double-clicked => { root.play-game(index); }
                        menu(x, y) => {
                            game-menu.show({ x: x - game-menu.absolute-position.x, y: y - game-menu.absolute-position.y });
                        }
                    }
                }
            }
            if root.games.length == 0: Text {
                text: root.scanning ? "Scanning…" : "No games found. Add a game folder in Settings.";
                color: Theme.muted;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.selected >= 0 && root.selected < root.games.length ? root.games[root.selected].name : "No game selected";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.status;
                    color: Theme.muted;
                    font-size: 11px;
                    overflow: elide;
                }
            }
            // While a game runs: "<game> is running" and a button for the console window.
            if root.running: HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.running-name + " is running";
                        color: Theme.text;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    console-btn := Rectangle {
                        width: 32px;
                        height: 26px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.card-border;
                        background: console-touch.has-hover ? #1e2533 : Theme.card;
                        Text {
                            text: ">_";
                            color: Theme.text;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        console-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-console(); }
                        }
                    }
                }
            }
        }
    }

    // Settings page: the values live here, the page binds to them.
    SettingsPage {
        visible: root.show-settings && !root.show-versions;
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        amd-cpu <=> root.amd-cpu;
        cmd-dump <=> root.cmd-dump;
        cmd-dump-folder <=> root.cmd-dump-folder;
        console-language <=> root.console-language;
        extra-args <=> root.extra-args;
        game-dir-list: root.game-dir-list;
        game-dir-selected <=> root.game-dir-selected;
        gpu-text <=> root.gpu-text;
        hdr <=> root.hdr;
        height-text <=> root.height-text;
        is-windows: root.is-windows;
        game-mode: root.game-mode;
        game-mode-name: root.game-mode-name;
        game-mode-serial: root.game-mode-serial;
        game-configs: root.game-configs;
        microphone <=> root.microphone;
        present-mode <=> root.present-mode;
        printf-dir <=> root.printf-dir;
        printf-file <=> root.printf-file;
        profiler <=> root.profiler;
        readback <=> root.readback;
        readback-tiled <=> root.readback-tiled;
        fullscreen <=> root.fullscreen;
        hide-cursor <=> root.hide-cursor;
        perf-panel <=> root.perf-panel;
        skip-boot-logos <=> root.skip-boot-logos;
        network-connected <=> root.network-connected;
        controller-color <=> root.controller-color;
        controller-swatch: root.controller-swatch;
        controller-vibration <=> root.controller-vibration;
        controller-volume <=> root.controller-volume;
        keyboard-player <=> root.keyboard-player;
        addons-dir <=> root.addons-dir;
        red-zone <=> root.red-zone;
        renderdoc <=> root.renderdoc;
        run-dir <=> root.run-dir;
        running: root.running;
        settings-tab <=> root.settings-tab;
        shader-log <=> root.shader-log;
        shader-log-folder <=> root.shader-log-folder;
        shader-opt <=> root.shader-opt;
        shader-validation <=> root.shader-validation;
        sync-raw <=> root.sync-raw;
        tessellation <=> root.tessellation;
        trophy <=> root.trophy;
        trophy-duration <=> root.trophy-duration;
        user-id-text <=> root.user-id-text;
        user-name <=> root.user-name;
        vblank-text <=> root.vblank-text;
        vulkan-validation <=> root.vulkan-validation;
        recommended-size: root.recommended-size;
        width-text <=> root.width-text;
        browse-run-dir => { root.browse-run-dir(); }
        browse-game-dir => { root.browse-game-dir(); }
        browse-addons-dir => { root.browse-addons-dir(); }
        import-ini => { root.import-kyty-ini(); }
        controller-color-edited(text) => { root.controller-color-edited(text); }
        remove-game-dir(i) => { root.remove-game-dir(i); }
        play => { root.play(); }
        stop => { root.stop(); }
        dry-run => { root.dry-run(); }
        save => { root.save(); }
        discard => { root.discard-settings(); }
        games-opened => { root.games-opened(); }
        open-game-settings(i) => { root.open-game-settings(i, false); }
        clear-game-emu(i) => { root.set-game-emu(i, -1); }
        pick-game-emu(i) => {
            root.pin-dialog-row = i;
            root.pin-pick = -1;
            root.pin-dialog-open = true;
        }
        reset-game => { root.reset-game-settings(); }
        back => {
            if (root.game-mode && !root.game-mode-from-library) {
                // Opened from the Games tab: back to that tab.
                root.leave-game-settings();
                root.settings-tab = 4;
            } else {
                root.show-settings = false;
                root.refresh-library();
            }
        }
        open-versions => {
            root.show-settings = false;
            root.show-trophies = false;
            root.show-versions = true;
            VM.opened();
        }
        delete-cache-requested => { root.delete-cache-prompt-open = true; }
    }

    // Version Manager page.
    if root.show-versions: VersionManagerPage {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        back => {
            root.show-versions = false;
        }
    }

    if root.show-trophies: TrophiesPage {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        back => {
            root.show-trophies = false;
        }
    }

    // Games tab > Set Emu...: pick one of the installed builds to pin the game to.
    if root.pin-dialog-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #000000a6;
        TouchArea { }
        Rectangle {
            width: min(520px, root.width - 48px);
            height: min(440px, root.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 4;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "Set emulator" + (root.pin-dialog-row >= 0 && root.pin-dialog-row < root.game-configs.length ? " for " + root.game-configs[root.pin-dialog-row].name : "");
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: "A \"-latest\" build follows its updates; a dated build stays exactly as it is.";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: #0b0e14;
                    border-width: 1px;
                    border-radius: 4px;
                    border-color: Theme.card-border;
                    clip: true;
                    ListView {
                        for build[i] in root.pin-builds: Rectangle {
                            height: 40px;
                            background: i == root.pin-pick ? Theme.row-selected : pin-touch.has-hover ? Theme.row-hover : transparent;
                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: center;
                                Text {
                                    text: build.name;
                                    color: Theme.text;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                                Text {
                                    text: build.path;
                                    color: Theme.faint;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                            pin-touch := TouchArea {
                                clicked => { root.pin-pick = i; }
                                double-clicked => {
                                    root.pin-pick = i;
                                    root.pin-dialog-open = false;
                                    root.set-game-emu(root.pin-dialog-row, i);
                                }
                            }
                        }
                    }
                    if root.pin-builds.length == 0: Text {
                        text: "No installed builds. Add one in the Version Manager.";
                        color: Theme.muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Button {
                        text: "Cancel";
                        clicked => { root.pin-dialog-open = false; }
                    }
                    Button {
                        text: "Set";
                        primary: true;
                        enabled: root.pin-pick >= 0 && root.pin-pick < root.pin-builds.length;
                        clicked => {
                            root.pin-dialog-open = false;
                            root.set-game-emu(root.pin-dialog-row, root.pin-pick);
                        }
                    }
                }
            }
        }
    }

    // "<game> is running - close anyway?" when the window is closed during a game.
    if root.close-prompt-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #000000a6;
        TouchArea { }
        Rectangle {
            width: min(420px, root.width - 48px);
            height: close-box.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 3;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            close-box := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: root.running-name + " is running";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: "Closing the launcher also closes the game. Close anyway?";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Button {
                        text: "Close anyway";
                        clicked => {
                            root.close-prompt-open = false;
                            root.confirm-close();
                        }
                    }
                    Button {
                        text: "Cancel";
                        primary: true;
                        clicked => { root.close-prompt-open = false; }
                    }
                }
            }
        }
    }

    // Settings > Versions > Delete cache asks first.
    if root.delete-cache-prompt-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #000000a6;
        TouchArea { }
        Rectangle {
            width: min(420px, root.width - 48px);
            height: cache-box.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 3;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            cache-box := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "Delete cache";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: "Clearing cache is not recommended, continue?";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Button {
                        text: "Continue";
                        clicked => {
                            root.delete-cache-prompt-open = false;
                            VM.delete-cache();
                        }
                    }
                    Button {
                        text: "Cancel";
                        primary: true;
                        clicked => { root.delete-cache-prompt-open = false; }
                    }
                }
            }
        }
    }

    // The old Qt launcher's Kyty.ini was imported (first run, or Settings > Paths > Import from Kyty.ini...).
    if root.import-summary-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #000000a6;
        TouchArea { }
        Rectangle {
            width: min(560px, root.width - 48px);
            height: min(import-box.preferred-height, root.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 3;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            // Escape and Enter both close it.
            FocusScope {
                x: 0px;
                y: 0px;
                width: 0px;
                height: 0px;
                init => { self.focus(); }
                key-pressed(event) => {
                    if (event.text == Key.Escape || event.text == Key.Return) {
                        root.import-summary-open = false;
                        return accept;
                    }
                    return reject;
                }
            }
            import-box := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "Settings imported from Kyty.ini";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                }
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 80px;
                    preferred-height: min(380px, max(root.height - 200px, 80px));
                    background: Theme.log-bg;
                    border-radius: 4px;
                    clip: true;
                    ScrollView {
                        VerticalLayout {
                            padding: 8px;
                            Text {
                                text: root.import-summary-text;
                                color: Theme.text;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "OK";
                        primary: true;
                        clicked => { root.import-summary-open = false; }
                    }
                }
            }
        }
    }

    // A newer release is out for a "-latest" build (checked at start and every hour).
    if VM.update-prompt-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #000000a6;
        TouchArea { }
        Rectangle {
            width: min(480px, root.width - 48px);
            height: update-box.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 3;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            // Escape is Later, Enter is Update.
            FocusScope {
                x: 0px;
                y: 0px;
                width: 0px;
                height: 0px;
                init => { self.focus(); }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        VM.update-prompt-open = false;
                        return accept;
                    }
                    if (event.text == Key.Return) {
                        VM.update-prompt-open = false;
                        VM.update-prompt-accept();
                        return accept;
                    }
                    return reject;
                }
            }
            update-box := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: VM.update-prompt-title;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: VM.update-prompt-text;
                    color: Theme.text;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Update replaces the installed build with the newest one.";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Button {
                        text: "Later";
                        clicked => { VM.update-prompt-open = false; }
                    }
                    Button {
                        text: "Update";
                        primary: true;
                        clicked => {
                            VM.update-prompt-open = false;
                            VM.update-prompt-accept();
                        }
                    }
                }
            }
        }
    }
}

// View > Console: the emulator output in its own window.
export component ConsoleWindow inherits Window {
    title: "Console";
    icon: @image-url("icons/app-icon.png");
    preferred-width: 900px;
    preferred-height: 560px;
    min-width: 480px;
    min-height: 240px;
    background: Theme.bg;
    in property <[string]> log-lines;
    callback clear();

    // Rows are fixed at 16px, so the end is known without waiting for layout.
    public function scroll-to-end() {
        log.content-y = min(0px, log.visible-height - root.log-lines.length * 16px);
    }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                overflow: elide;
                text: root.log-lines.length + " lines";
                color: Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: "Clear";
                clicked => { root.clear(); }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.log-bg;
            border-radius: 6px;
            clip: true;
            log := ListView {
                for line in root.log-lines: Text {
                    height: 16px;
                    x: 8px;
                    text: line;
                    color: #b9c4d2;
                    font-family: "Consolas";
                    font-size: 12px;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
    }
}
