    Part { k: root.k; id: "Triangle"; tip: "Triangle"; x0: 353; y0: 87; w: 26; h: 26; shape: "M 0 13 A 13 13 0 1 0 26 13 A 13 13 0 1 0 0 13 Z"; glyph: "M 13 6 L 20 18 L 6 18 Z"; }
