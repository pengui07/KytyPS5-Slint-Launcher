    Part { k: root.k; id: "LeftStickLeft"; tip: "Left stick left"; x0: 142; y0: 161.35; w: 15.38; h: 45.3; shape: "M 9.09 1 A 33 33 0 0 0 9.09 44.3 L 14.38 39.71 A 26 26 0 0 1 14.38 5.59 Z"; ghost: true; clickable: Controls.tab == 1; }
    Part { k: root.k; id: "RightStickUp"; tip: "Right stick up"; x0: 281.35; y0: 150; w: 45.3; h: 15.38; shape: "M 44.3 9.09 A 33 33 0 0 0 1 9.09 L 5.59 14.38 A 26 26 0 0 1 39.71 14.38 Z"; ghost: true; clickable: Controls.tab == 1; }
    Part { k: root.k; id: "RightStickRight"; tip: "Right stick right"; x0: 322.62; y0: 161.35; w: 15.38; h: 45.3; shape: "M 6.28 44.3 A 33 33 0 0 0 6.28 1 L 1 5.59 A 26 26 0 0 1 1 39.71 Z"; ghost: true; clickable: Controls.tab == 1; }
    Part { k: root.k; id: "RightStickDown"; tip: "Right stick down"; x0: 281.35; y0: 202.62; w: 45.3; h: 15.38; shape: "M 1 6.28 A 33 33 0 0 0 44.3 6.28 L 39.71 1 A 26 26 0 0 1 5.59 1 Z"; ghost: true; clickable: Controls.tab == 1; }
    Part { k: root.k; id: "RightStickLeft"; tip: "Right stick left"; x0: 270; y0: 161.35; w: 15.38; h: 45.3; shape: "M 9.09 1 A 33 33 0 0 0 9.09 44.3 L 14.38 39.71 A 26 26 0 0 1 14.38 5.59 Z"; ghost: true; clickable: Controls.tab == 1; }
}

// The groups of one tab, row by row, with the diagram on the right. When the window is too narrow for it there,
// the diagram takes the grid's empty slot instead (next to System / the shortcuts).
component TabGrid inherits HorizontalLayout {
    in property <[ControlRow]> rows;
    in property <bool> pad;
    in property <length> room; // the width the grid may use
    property <int> columns: root.pad ? 2 : 3;
    property <length> cards-w: Grid.card-w * root.columns + Grid.gap * (root.columns - 1);
    // Beside the grid, the diagram takes what is left up to its full size; below 0.55 it moves into the slot.
    property <float> k: min(1, (root.room - root.cards-w - Grid.gap * 2) / Grid.diagram-w);
    property <bool> beside: root.k >= 0.55;
    property <float> slot-k: Grid.card-w / Grid.diagram-w;
    property <string> gyro-note: "The gyro emulation toggle activates tilt mode on gamepads without a gyroscope: the right stick then controls pitch and roll. It defaults to the View/Back button.";
    spacing: Grid.gap * 2;
    alignment: start;

    VerticalLayout {
        alignment: start;
        spacing: Grid.gap;
        if root.pad: HorizontalLayout {
            spacing: Grid.gap;
            Section { rows: root.rows; pad: root.pad; section: "Face buttons"; }
            Section { rows: root.rows; pad: root.pad; section: "D-pad"; }
        }
        if root.pad: HorizontalLayout {
            spacing: Grid.gap;
            Section { rows: root.rows; pad: root.pad; section: "Shoulders & triggers"; }
            Section { rows: root.rows; pad: root.pad; section: "Stick clicks"; }
        }
        if root.pad: HorizontalLayout {
            spacing: Grid.gap;
            Section { rows: root.rows; pad: root.pad; section: "System"; }
            if root.beside: Text {
                width: Grid.card-w;
                text: root.gyro-note;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            if !root.beside: ControllerDiagram { k: root.slot-k; }
        }
        if root.pad && !root.beside: Text {
            width: root.cards-w;
            text: root.gyro-note;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }
        if !root.pad: HorizontalLayout {
            spacing: Grid.gap;
            Section { rows: root.rows; pad: root.pad; section: "Face buttons"; }
            Section { rows: root.rows; pad: root.pad; section: "D-pad"; }
            Section { rows: root.rows; pad: root.pad; section: "Left stick"; }
        }
        if !root.pad: HorizontalLayout {
            spacing: Grid.gap;
            Section { rows: root.rows; pad: root.pad; section: "Shoulders & triggers"; }
            Section { rows: root.rows; pad: root.pad; section: "Stick clicks"; }
            Section { rows: root.rows; pad: root.pad; section: "Right stick"; }
        }
        if !root.pad: HorizontalLayout {
            spacing: Grid.gap;
            Section { rows: root.rows; pad: root.pad; section: "System"; }
            Section { rows: root.rows; pad: root.pad; section: "In-game shortcuts (cycle)"; }
            if root.beside: Gap { }
            if !root.beside: ControllerDiagram { k: root.slot-k; }
        }
    }
    if root.beside: VerticalLayout {
        alignment: center;
        ControllerDiagram { k: root.k; }
    }
}

export component ControlsPage inherits Rectangle {
    callback close();
    background: Theme.panel; // the groups' titles cover their frame with this colour

    // Clicks that miss the page's own controls stop here instead of reaching the library under it.
    TouchArea { }

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        padding: 18px;
        padding-left: 24px;
        padding-right: 24px;
        spacing: 10px;

        // The way back and the tabs on one strip, as on the Settings page: the band and its hairline run
        // to the window edges, and the active tab opens into the page.
        Rectangle {
            height: 28px;
            Rectangle {
                x: -24px;
                y: -18px;
                width: parent.width + 48px;
                height: parent.height + 18px;
                background: Theme.bg;
            }
            Rectangle {
                x: -24px;
                y: parent.height - 1px;
                width: parent.width + 48px;
                height: 1px;
                background: Theme.card-border;
            }
            HorizontalLayout {
                spacing: 2px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    AppButton {
                        width: 110px;
                        height: 28px;
                        text: "← Library";
                        clicked => { root.close(); }
                    }
                }
                for tab[i] in ["Gamepad", "Keyboard & Mouse"]: TabButton {
                    width: 140px;
                    text: tab;
                    active: i == Controls.tab;
                    clicked => {
                        if (!Controls.listening) {
                            Controls.tab = i;
                        }
                    }
                }
            }
        }

        // The tab's own line: the controller's state, or the mouse sensitivity.
        if Controls.tab == 0: Text {
            text: Controls.status;
            color: Theme.text;
            font-size: 12px;
        }
        if Controls.tab == 1: HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text {
                text: "Mouse sensitivity";
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                AppSlider {
                    width: 220px;
                    minimum: 0.1;
                    maximum: 5.0;
                    step: 0.1;
                    value <=> Controls.sensitivity;
                    changed(value) => { Controls.sensitivity-edited(value); }
                }
            }
            Text {
                width: 40px;
                text: Controls.sensitivity-text;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
            }
            Text {
                text: "F7 in-game toggles mouse movement on the right stick.";
                color: Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        // The groups. They scroll when the window is too short for them; everything else stays put.
        grid-view := ScrollView {
            vertical-stretch: 1;
            // At least the grid's own width: in a narrow window the three keyboard columns scroll sideways
            // instead of being cut off.
            content-width: max(self.visible-width, Grid.card-w * (Controls.tab == 0 ? 2 : 3) + Grid.gap * (Controls.tab == 0 ? 1 : 2));
            VerticalLayout {
                width: grid-view.content-width;
                padding-top: 8px; // room for the top groups' titles, which rise above their frames
                padding-bottom: 4px;
                if Controls.tab == 0: TabGrid { rows: Controls.gamepad-rows; pad: true; room: grid-view.visible-width; }
                if Controls.tab == 1: TabGrid { rows: Controls.keyboard-rows; pad: false; room: grid-view.visible-width; }
            }
        }

        // The emulated touch pad: shared by both tabs, as in upstream.
        Card {
            title: "Emulated touch pad (shared by both tabs)";
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "Particle skin";
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Dropdown {
                        width: 150px;
                        model: ["Classic", "Blue neon", "Monochrome", "Crimson", "Red/Blue"];
                        current-index <=> Controls.skin-index;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    AppCheckBox {
                        text: "Show hand cursor and trail";
                        checked <=> Controls.show-cursor;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "Toggle with the touch pad mode key (F6 by default); draw with left mouse / Cross.";
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                    min-width: 0px;
                    horizontal-stretch: 1;
                }
            }
        }

        // The tip (or what went wrong) and the page's actions, as at the bottom of the Qt dialog.
        HorizontalLayout {
            spacing: 10px;
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: Controls.notice != "" ? Controls.notice : "Tip: right-click a binding to unmap it.";
                color: Controls.notice != "" ? Theme.danger : Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            AppButton {
                width: 150px;
                text: "Restore Defaults";
                clicked => { Controls.restore-defaults(Controls.tab == 0); }
            }
            Rectangle { width: 30px; }
            AppButton {
                width: 100px;
                text: "Save";
                primary: true;
                clicked => { Controls.save(); }
            }
            AppButton {
                width: 100px;
                text: "Cancel";
                clicked => { Controls.cancel(); }
            }
        }
    }

    // Capture: the page keeps its input, the overlay only says what to press.
    if Controls.listening: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.scrim;
        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
        }
        Rectangle {
            width: min(460px, root.width - 48px);
            height: capture-box.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 3;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            border-radius: 0px;
            capture-box := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "Set binding — " + Controls.capture-label;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: Controls.capture-message;
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if Controls.capture-pad: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Or pick one from the list:";
                        color: Theme.muted;
                        font-size: 12px;
                    }
                    Dropdown {
                        model: Controls.pad-sources;
                        selected => { Controls.pick-source(self.current-index); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    AppButton {
                        text: "Cancel";
                        clicked => { Controls.cancel-capture(); }
                    }
                }
            }
        }
    }
}
