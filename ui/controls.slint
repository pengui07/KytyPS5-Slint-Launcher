    // The controls, in upstream's order (later ones paint over earlier ones).
    Part { k: root.k; id: "L2"; tip: "L2"; x0: 76.94; y0: 8.94; w: 60; h: 32; shape: "M 1 31 L 6 13 C 8 4 16 1 30 1 C 44 1 52 4 54 13 L 59 31 Z"; label: "L2"; label-x: 30; label-y: 16; }
    Part { k: root.k; id: "R2"; tip: "R2"; x0: 343.06; y0: 8.94; w: 60; h: 32; shape: "M 1 31 L 6 13 C 8 4 16 1 30 1 C 44 1 52 4 54 13 L 59 31 Z"; label: "R2"; label-x: 30; label-y: 16; }
    Part { k: root.k; id: "L1"; tip: "L1"; x0: 74.23; y0: 41.94; w: 69.55; h: 26.36; shape: "M 6.5 25.36 L 9.01 24.42 L 11.6 23.51 L 14.28 22.61 L 17.03 21.74 L 19.87 20.89 L 22.78 20.07 L 25.77 19.26 L 28.84 18.48 L 31.97 17.72 L 35.17 16.98 L 38.44 16.27 L 41.78 15.57 L 45.18 14.9 L 48.64 14.25 L 52.16 13.63 L 55.73 13.02 L 59.36 12.44 L 63.05 11.88 A 5.5 5.5 0 0 0 61.44 1 L 57.67 1.57 L 53.95 2.17 L 50.28 2.79 L 46.66 3.43 L 43.1 4.1 L 39.6 4.79 L 36.15 5.51 L 32.76 6.25 L 29.44 7.01 L 26.18 7.8 L 22.98 8.62 L 19.85 9.46 L 16.79 10.33 L 13.8 11.23 L 10.88 12.15 L 8.03 13.1 L 5.25 14.09 L 2.54 15.1 A 5.5 5.5 0 0 0 6.5 25.36 Z"; label: "L1"; label-x: 30.71; label-y: 12.37; }
