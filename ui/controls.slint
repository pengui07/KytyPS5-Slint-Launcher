// Controls page: the PS5 controls mapped to keyboard keys / mouse buttons and to gamepad buttons.
// The Qt launcher's Controls dialog, as a page: two tabs, click a binding then press, right-click clears.
// Laid out like the dialog: the sections as framed groups in a grid, a controller diagram on the right
// (the hovered or captured control lights up; clicking a part starts its capture), the emulated touch
// pad below, and Restore Defaults / Save / Cancel along the bottom.

import { ScrollView } from "std-widgets.slint";
import { Theme, Card, Dropdown, AppButton, AppCheckBox, AppSlider } from "common.slint";

// One row: a PS5 control and the binding it shows.
export struct ControlRow {
    id: string,
    label: string,
    binding: string,     // as shown ("None" when unbound)
    section: string,
    section-start: bool, // first row of its section
}

// State of the page (the C++ side fills it when the page opens).
export global Controls {
    in-out property <int> tab: 0; // 0 = Gamepad, 1 = Keyboard & Mouse
    in property <[ControlRow]> gamepad-rows;
    in property <[ControlRow]> keyboard-rows;
    in property <[string]> pad-sources; // labels of every gamepad button / trigger, table order
    in property <bool> listening;       // a capture is running: the overlay is up
    in property <string> capture-id;    // the row being captured
    in property <bool> capture-pad;     // the capture started on the gamepad tab (tabs lock while listening)
    in property <string> capture-label; // its control label, for the overlay title
    in property <string> capture-message;
    in property <string> status; // "Connected: Controller 1" / "No controller connected"
    in-out property <string> notice;
    in-out property <float> sensitivity: 1.0;
    in property <string> sensitivity-text: "1.0×";
    in-out property <int> skin-index: 0;
    in-out property <bool> show-cursor: true;
    // The control under the mouse, in the list or on the diagram (UI only): both light it up.
    in-out property <string> hover-id;

    callback opened();
    callback begin-capture(string, bool); // control id, gamepad tab
    callback clear-binding(string, bool);
    callback pick-source(int); // index in pad-sources
    callback restore-defaults(bool); // gamepad tab
    callback sensitivity-edited(float);
    callback cancel-capture();
    callback save();
    callback cancel();
    callback close();
}

// Sizes of the grid: every group is the same width so the columns line up.
global Grid {
    out property <length> label-w: 172px;
    out property <length> button-w: 138px;
    out property <length> row-h: 26px;
    out property <length> row-gap: 6px;
    out property <length> card-w: 340px; // label + gap + button + the Card's padding and border
    out property <length> gap: 14px;
    out property <length> diagram-w: 420px; // the diagram's full size; it shrinks to the room left
    out property <length> diagram-h: 300px;
}

// One tab of the strip; the active one has an accent underline.
component TabHeader inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    width: 170px;
    height: 32px;
    border-radius: 0px;
    background: root.active ? Theme.tint(0.08) : touch.has-hover ? Theme.tint(0.04) : transparent;
    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        color: root.active ? Theme.text : Theme.muted;
        font-size: 13px;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        visible: root.active;
        y: parent.height - 2px;
        height: 2px;
        width: parent.width - 24px;
        x: 12px;
        background: Theme.accent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Label on the left, the binding button on the right. Click binds, right-click clears (upstream's behaviour).
// A row of another section is collapsed to nothing (a group shows only its own section's rows).
component BindingRow inherits Rectangle {
    in property <ControlRow> entry;
    in property <bool> pad;
    in property <bool> shown: true;
    property <bool> capturing: Controls.listening && Controls.capture-id == root.entry.id;
    property <bool> lit: root.capturing || Controls.hover-id == root.entry.id;
    property <bool> hovered: bind.has-hover;
    visible: root.shown;
    height: root.shown ? Grid.row-h + Grid.row-gap : 0px;

    changed hovered => {
        if (root.hovered) {
            Controls.hover-id = root.entry.id;
        } else if (Controls.hover-id == root.entry.id) {
            Controls.hover-id = "";
        }
    }

    Text {
        x: 2px;
        y: 0px;
        width: Grid.label-w - 2px;
        height: Grid.row-h;
        text: root.entry.label;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: Grid.label-w + 8px;
        y: 0px;
        width: Grid.button-w;
        height: Grid.row-h;
        border-radius: 0px;
        border-width: 1px;
        border-color: root.lit ? Theme.accent : Theme.card-border;
        background: bind.has-hover ? Theme.control-hover : Theme.log-bg;
        Text {
            x: 6px;
            width: parent.width - 12px;
            text: root.capturing ? "Press…" : root.entry.binding;
            color: root.capturing ? Theme.accent : root.entry.binding == "None" ? Theme.faint : Theme.text;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        bind := TouchArea {
            mouse-cursor: pointer;
            // Right-click clears on press (upstream behaviour); left binds on click.
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                    Controls.clear-binding(root.entry.id, root.pad);
                }
            }
            clicked => { Controls.begin-capture(root.entry.id, root.pad); }
        }
    }
}

// One framed group: the rows of one section, in the order the C++ side sends them.
component Section inherits Card {
    in property <[ControlRow]> rows;
    in property <bool> pad;
    in property <string> section;
    title: root.section;
    width: Grid.card-w;
    VerticalLayout {
        spacing: 0px;
        padding-bottom: -Grid.row-gap; // the last row's gap; the Card pads the bottom itself
        for row in root.rows: BindingRow {
            entry: row;
            pad: root.pad;
            shown: row.section == root.section;
        }
    }
}

// An empty slot in a grid row, so a short row keeps its columns.
component Gap inherits Rectangle {
    width: Grid.card-w;
}

// ---- The controller diagram: a DualSense drawn on a 420 x 300 canvas, scaled by k. ----

// One button of the diagram, placed by its centre and size in canvas units.
component Part inherits Rectangle {
    in property <string> id; // the control it maps to ("" = decoration only)
    in property <float> k: 1;
    in property <float> cx;
    in property <float> cy;
    in property <float> w;
    in property <float> h;
    in property <float> corner: -1; // -1 = fully round
    in property <bool> lit;
    in property <string> label;
    in property <string> glyph; // SVG path on a 10 x 10 box, drawn in the middle
    in property <bool> ring; // a stick: an inner ring for the cap
    in property <string> shape; // SVG path on the part's own w x h box, drawn instead of the rounded frame
    in property <float> label-x: -1; // where the label is centred, in the part's units (-1 = the middle)
    in property <float> label-y: -1;
    property <color> ink: root.lit ? Theme.accent : touch.has-hover && root.id != "" ? Theme.text : Theme.muted;
    property <color> wash: root.lit ? Theme.accent.with-alpha(0.25) : transparent;
    property <bool> hovered: touch.has-hover;
    x: (root.cx - root.w / 2) * root.k * 1px;
    y: (root.cy - root.h / 2) * root.k * 1px;
    width: root.w * root.k * 1px;
    height: root.h * root.k * 1px;
    border-width: root.shape == "" ? 1.5px : 0px;
    border-radius: root.corner < 0 ? min(self.width, self.height) / 2 : root.corner * root.k * 1px;
    border-color: root.ink;
    background: root.shape == "" ? root.wash : transparent;

    changed hovered => {
        if (root.id == "") {
            return;
        }
        if (root.hovered) {
            Controls.hover-id = root.id;
        } else if (Controls.hover-id == root.id) {
            Controls.hover-id = "";
        }
    }

    if root.shape != "": Path {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        viewbox-width: root.w;
        viewbox-height: root.h;
        commands: root.shape;
        stroke: root.ink;
        stroke-width: 1.5px;
        fill: root.lit ? root.wash : Theme.card;
    }
    if root.ring: Rectangle {
        width: parent.width * 0.68;
        height: parent.height * 0.68;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: root.ink;
    }
    if root.glyph != "": Path {
        width: parent.width * 0.55;
        height: parent.height * 0.55;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: root.glyph;
        stroke: root.ink;
        stroke-width: 1.5px;
        fill: transparent;
    }
    if root.label != "": Text {
        x: root.label-x < 0 ? (parent.width - self.width) / 2 : root.label-x * root.k * 1px - self.width / 2;
        y: root.label-y < 0 ? (parent.height - self.height) / 2 : root.label-y * root.k * 1px - self.height / 2;
        text: root.label;
        color: root.ink;
        font-size: max(8px, 10px * root.k);
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.id != "";
        mouse-cursor: root.id != "" ? pointer : default;
        clicked => {
            if (!Controls.listening) {
                Controls.begin-capture(root.id, Controls.tab == 0);
            }
        }
    }
}

component ControllerDiagram inherits Rectangle {
    in property <float> k: 1;
    // The highlighted control: the one being captured, else the hovered one.
    property <string> on: Controls.listening ? Controls.capture-id : Controls.hover-id;
    property <bool> left-stick: on == "L3" || on == "LeftStickUp" || on == "LeftStickDown" || on == "LeftStickLeft" || on == "LeftStickRight";
    property <bool> right-stick: on == "R3" || on == "RightStickUp" || on == "RightStickDown" || on == "RightStickLeft" || on == "RightStickRight";
    width: 420px * root.k;
    height: 300px * root.k;

    // The body outline, shoulders to grips.
    Path {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        viewbox-width: 420;
        viewbox-height: 300;
        commands: "M 130 46 L 290 46 C 332 46 360 50 372 66 C 398 118 418 200 416 246 C 414 284 384 294 364 274 C 346 254 330 214 312 198 C 282 186 138 186 108 198 C 90 214 74 254 56 274 C 36 294 6 284 4 246 C 2 200 22 118 48 66 C 60 50 88 46 130 46 Z";
        stroke: Theme.muted;
        stroke-width: 1.5px;
        fill: Theme.card;
    }

    // Shoulders and triggers: the bumper follows the body's shoulder, the trigger rises behind it.
    Part { k: root.k; id: "L2"; label: "L2"; cx: 86; cy: 20; w: 68; h: 40; shape: "M 6 36 C 18 28 38 24 64 24 L 62 12 C 60 5 48 1 36 1 C 20 1 8 8 4 22 Z"; label-x: 35; label-y: 13; lit: root.on == self.id; }
    Part { k: root.k; id: "L1"; label: "L1"; cx: 85; cy: 44; w: 90; h: 40; shape: "M 4 36 C 16 19 44 15 82 15 A 5.5 5.5 0 0 0 82 4 C 44 4 18 8 10 22 Q 2 30 4 36 Z"; label-x: 66; label-y: 9.5; lit: root.on == self.id; }
    Part { k: root.k; id: "R2"; label: "R2"; cx: 334; cy: 20; w: 68; h: 40; shape: "M 62 36 C 50 28 30 24 4 24 L 6 12 C 8 5 20 1 32 1 C 48 1 60 8 64 22 Z"; label-x: 33; label-y: 13; lit: root.on == self.id; }
    Part { k: root.k; id: "R1"; label: "R1"; cx: 335; cy: 44; w: 90; h: 40; shape: "M 86 36 C 74 19 46 15 8 15 A 5.5 5.5 0 0 1 8 4 C 46 4 72 8 80 22 Q 88 30 86 36 Z"; label-x: 24; label-y: 9.5; lit: root.on == self.id; }

    // Touch pad (the right half lights up for its keyboard-only "right" click), Create and Options.
    Part { k: root.k; id: "TouchPad"; cx: 210; cy: 86; w: 140; h: 70; corner: 8; lit: root.on == self.id; }
    Rectangle {
        visible: root.on == "TouchPadRight";
        x: 210px * root.k;
        y: 51px * root.k;
        width: 70px * root.k;
        height: 70px * root.k;
        background: Theme.accent.with-alpha(0.25);
        border-width: 1.5px;
        border-color: Theme.accent;
        border-radius: 8px * root.k;
    }
    Part { k: root.k; id: "GyroToggle"; cx: 124; cy: 66; w: 8; h: 18; lit: root.on == self.id; }
    Part { k: root.k; id: "Options"; cx: 296; cy: 66; w: 8; h: 18; lit: root.on == self.id; }

    // D-pad.
    Part { k: root.k; id: "Up"; cx: 92; cy: 92; w: 18; h: 22; corner: 3; glyph: "M 2 7 L 5 3 L 8 7"; lit: root.on == self.id; }
    Part { k: root.k; id: "Down"; cx: 92; cy: 136; w: 18; h: 22; corner: 3; glyph: "M 2 3 L 5 7 L 8 3"; lit: root.on == self.id; }
    Part { k: root.k; id: "Left"; cx: 70; cy: 114; w: 22; h: 18; corner: 3; glyph: "M 7 2 L 3 5 L 7 8"; lit: root.on == self.id; }
    Part { k: root.k; id: "Right"; cx: 114; cy: 114; w: 22; h: 18; corner: 3; glyph: "M 3 2 L 7 5 L 3 8"; lit: root.on == self.id; }

    // Face buttons.
    Part { k: root.k; id: "Triangle"; cx: 328; cy: 90; w: 24; h: 24; glyph: "M 5 1.5 L 9 8.5 L 1 8.5 Z"; lit: root.on == self.id; }
    Part { k: root.k; id: "Circle"; cx: 352; cy: 114; w: 24; h: 24; glyph: "M 5 1.5 A 3.5 3.5 0 1 1 4.99 1.5 Z"; lit: root.on == self.id; }
    Part { k: root.k; id: "Cross"; cx: 328; cy: 138; w: 24; h: 24; glyph: "M 2 2 L 8 8 M 8 2 L 2 8"; lit: root.on == self.id; }
    Part { k: root.k; id: "Square"; cx: 304; cy: 114; w: 24; h: 24; glyph: "M 2 2 L 8 2 L 8 8 L 2 8 Z"; lit: root.on == self.id; }

    // Sticks (L3 / R3, and the stick directions of the keyboard tab) and the PS button.
    Part { k: root.k; id: "L3"; cx: 156; cy: 160; w: 52; h: 52; ring: true; lit: root.left-stick; }
    Part { k: root.k; id: "R3"; cx: 264; cy: 160; w: 52; h: 52; ring: true; lit: root.right-stick; }
    Part { k: root.k; cx: 210; cy: 164; w: 14; h: 14; }
}

// The groups of one tab, row by row, with the diagram on the right.
component TabGrid inherits HorizontalLayout {
    in property <[ControlRow]> rows;
    in property <bool> pad;
    in property <length> room; // the width the grid may use
    property <int> columns: root.pad ? 2 : 3;
    property <length> cards-w: Grid.card-w * root.columns + Grid.gap * (root.columns - 1);
    // The diagram takes what is left, up to its full size, and hides when that is too small to read.
    property <float> k: min(1, (root.room - root.cards-w - Grid.gap * 2) / Grid.diagram-w);
    spacing: Grid.gap * 2;
    alignment: start;

    VerticalLayout {
        alignment: start;
        spacing: Grid.gap;
        if root.pad: HorizontalLayout {
            spacing: Grid.gap;
            Section { rows: root.rows; pad: root.pad; section: "Face buttons"; }
            Section { rows: root.rows; pad: root.pad; section: "D-pad"; }
        }
        if root.pad: HorizontalLayout {
            spacing: Grid.gap;
            Section { rows: root.rows; pad: root.pad; section: "Shoulders & triggers"; }
            Section { rows: root.rows; pad: root.pad; section: "Stick clicks"; }
        }
        if root.pad: HorizontalLayout {
            spacing: Grid.gap;
            Section { rows: root.rows; pad: root.pad; section: "System"; }
            Text {
                width: Grid.card-w;
                text: "The gyro emulation toggle activates tilt mode on gamepads without a gyroscope: the right stick then controls pitch and roll. It defaults to the View/Back button.";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
        if !root.pad: HorizontalLayout {
            spacing: Grid.gap;
            Section { rows: root.rows; pad: root.pad; section: "Face buttons"; }
            Section { rows: root.rows; pad: root.pad; section: "D-pad"; }
            Section { rows: root.rows; pad: root.pad; section: "Left stick"; }
        }
        if !root.pad: HorizontalLayout {
            spacing: Grid.gap;
            Section { rows: root.rows; pad: root.pad; section: "Shoulders & triggers"; }
            Section { rows: root.rows; pad: root.pad; section: "Stick clicks"; }
            Section { rows: root.rows; pad: root.pad; section: "Right stick"; }
        }
        if !root.pad: HorizontalLayout {
            spacing: Grid.gap;
            Section { rows: root.rows; pad: root.pad; section: "System"; }
            Section { rows: root.rows; pad: root.pad; section: "In-game shortcuts (cycle)"; }
            Gap { }
        }
    }
    if root.k >= 0.55: VerticalLayout {
        alignment: center;
        ControllerDiagram { k: root.k; }
    }
}

export component ControlsPage inherits Rectangle {
    callback close();
    background: Theme.panel; // the groups' titles cover their frame with this colour

    // Clicks that miss the page's own controls stop here instead of reaching the library under it.
    TouchArea { }

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        padding: 18px;
        padding-left: 24px;
        padding-right: 24px;
        spacing: 10px;

        // Title and the way back to the library.
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                AppButton {
                    width: 110px;
                    text: "← Library";
                    clicked => { root.close(); }
                }
            }
            Text {
                text: "Controls";
                color: Theme.text;
                font-size: 20px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            TabHeader { text: "Gamepad"; active: Controls.tab == 0; clicked => { if (!Controls.listening) { Controls.tab = 0; } } }
            TabHeader { text: "Keyboard & Mouse"; active: Controls.tab == 1; clicked => { if (!Controls.listening) { Controls.tab = 1; } } }
        }

        // What the tab is for, and its own extra line: the controller's state, or the mouse sensitivity.
        Text {
            text: Controls.tab == 0
                ? "Choose which button on your gamepad triggers each PS5 control. Click a binding, then press the button or trigger you want to use."
                : "Choose which keyboard key or mouse button triggers each PS5 control. Click a binding, then press the key or mouse button.";
            color: Theme.muted;
            font-size: 12px;
            overflow: elide;
        }
        if Controls.tab == 0: HorizontalLayout {
            spacing: 16px;
            alignment: start;
            Text {
                text: Controls.status;
                color: Theme.text;
                font-size: 12px;
            }
            Text {
                text: "Older/fork builds may exit with 'Invalid input mapping' when a Pad: binding is set.";
                color: Theme.faint;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
        if Controls.tab == 1: HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text {
                text: "Mouse sensitivity";
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                AppSlider {
                    width: 220px;
                    minimum: 0.1;
                    maximum: 5.0;
                    step: 0.1;
                    value <=> Controls.sensitivity;
                    changed(value) => { Controls.sensitivity-edited(value); }
                }
            }
            Text {
                width: 40px;
                text: Controls.sensitivity-text;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
            }
            Text {
                text: "F7 in-game toggles mouse movement on the right stick.";
                color: Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        // The groups. They scroll when the window is too short for them; everything else stays put.
        grid-view := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            VerticalLayout {
                width: grid-view.visible-width;
                padding-top: 8px; // room for the top groups' titles, which rise above their frames
                padding-bottom: 4px;
                if Controls.tab == 0: TabGrid { rows: Controls.gamepad-rows; pad: true; room: grid-view.visible-width; }
                if Controls.tab == 1: TabGrid { rows: Controls.keyboard-rows; pad: false; room: grid-view.visible-width; }
            }
        }

        // The emulated touch pad: shared by both tabs, as in upstream.
        Card {
            title: "Emulated touch pad (shared by both tabs)";
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "Particle skin";
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Dropdown {
                        width: 150px;
                        model: ["Classic", "Blue neon", "Monochrome", "Crimson", "Red/Blue"];
                        current-index <=> Controls.skin-index;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    AppCheckBox {
                        text: "Show hand cursor and trail";
                        checked <=> Controls.show-cursor;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "Toggle with the touch pad mode key (F6 by default); draw with left mouse / Cross.";
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                    min-width: 0px;
                    horizontal-stretch: 1;
                }
            }
        }

        // The tip (or what went wrong) and the page's actions, as at the bottom of the Qt dialog.
        HorizontalLayout {
            spacing: 10px;
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: Controls.notice != "" ? Controls.notice : "Tip: right-click a binding to unmap it.";
                color: Controls.notice != "" ? Theme.danger : Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            AppButton {
                width: 150px;
                text: "Restore Defaults";
                clicked => { Controls.restore-defaults(Controls.tab == 0); }
            }
            Rectangle { width: 30px; }
            AppButton {
                width: 100px;
                text: "Save";
                primary: true;
                clicked => { Controls.save(); }
            }
            AppButton {
                width: 100px;
                text: "Cancel";
                clicked => { Controls.cancel(); }
            }
        }
    }

    // Capture: the page keeps its input, the overlay only says what to press.
    if Controls.listening: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.scrim;
        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
        }
        Rectangle {
            width: min(460px, root.width - 48px);
            height: capture-box.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 3;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            border-radius: 0px;
            capture-box := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "Set binding — " + Controls.capture-label;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: Controls.capture-message;
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if Controls.capture-pad: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Or pick one from the list:";
                        color: Theme.muted;
                        font-size: 12px;
                    }
                    Dropdown {
                        model: Controls.pad-sources;
                        selected => { Controls.pick-source(self.current-index); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    AppButton {
                        text: "Cancel";
                        clicked => { Controls.cancel-capture(); }
                    }
                }
            }
        }
    }
}
