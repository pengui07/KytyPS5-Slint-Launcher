// Controls page: the PS5 controls mapped to keyboard keys / mouse buttons and to gamepad buttons.
// The Qt launcher's Controls dialog, as a page: two tabs, click a binding then press, right-click clears.

import { ScrollView } from "std-widgets.slint";
import { Theme, Dropdown, AppButton, AppCheckBox, AppSlider } from "common.slint";

// One row: a PS5 control and the binding it shows.
export struct ControlRow {
    id: string,
    label: string,
    binding: string,     // as shown ("None" when unbound)
    section: string,
    section-start: bool, // first row of its section: the section title goes above it
}

// State of the page (the C++ side fills it when the page opens).
export global Controls {
    in-out property <int> tab: 0; // 0 = Gamepad, 1 = Keyboard & Mouse
    in property <[ControlRow]> gamepad-rows;
    in property <[ControlRow]> keyboard-rows;
    // Manual scroll positions (wheel/drag/scrollbar are unreliable here): the lists
    // bind their content-y here, and the action-row buttons step them.
    in-out property <length> gamepad-y: 0px;
    in-out property <length> keyboard-y: 0px;
    in property <[string]> pad-sources; // labels of every gamepad button / trigger, table order
    in property <bool> listening;       // a capture is running: the overlay is up
    in property <string> capture-id;    // the row being captured
    in property <bool> capture-pad;     // the capture started on the gamepad tab (tabs lock while listening)
    in property <string> capture-label; // its control label, for the overlay title
    in property <string> capture-message;
    in property <string> status; // "Connected: Controller 1" / "No controller connected"
    in-out property <string> notice;
    in-out property <float> sensitivity: 1.0;
    in property <string> sensitivity-text: "1.0×";
    in-out property <int> skin-index: 0;
    in-out property <bool> show-cursor: true;

    callback opened();
    callback begin-capture(string, bool); // control id, gamepad tab
    callback clear-binding(string, bool);
    callback pick-source(int); // index in pad-sources
    callback restore-defaults(bool); // gamepad tab
    callback sensitivity-edited(float);
    callback cancel-capture();
    callback save();
    callback cancel();
    callback close();
}

// One tab of the strip; the active one has an accent underline.
component TabHeader inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    width: 170px;
    height: 32px;
    border-radius: 0px;
    background: root.active ? Theme.tint(0.08) : touch.has-hover ? Theme.tint(0.04) : transparent;
    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        color: root.active ? Theme.text : Theme.muted;
        font-size: 13px;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        visible: root.active;
        y: parent.height - 2px;
        height: 2px;
        width: parent.width - 24px;
        x: 12px;
        background: Theme.accent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Label on the left, the binding button on the right. Click binds, right-click clears (upstream's behaviour).
// NOTE: no `horizontal-stretch` anywhere in a row: stretch inside the ScrollView's
// unbounded content evaluates to infinity and pushes everything after it off-screen
// (the buttons painted nothing while still receiving clicks). Fixed widths instead.
component BindingRow inherits HorizontalLayout {
    in property <ControlRow> entry;
    in property <bool> pad;
    height: 30px;
    spacing: 8px;
    padding-left: 2px;
    Text {
        width: 280px;
        text: root.entry.label;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        width: 196px;
        border-radius: 0px;
        border-width: 1px;
        border-color: capturing ? Theme.accent : bind.has-hover ? Theme.accent : Theme.card-border;
        background: bind.has-hover ? Theme.control-hover : Theme.log-bg;
        VerticalLayout {
            alignment: center;
            Text {
                text: capturing ? "Press…" : root.entry.binding;
                color: capturing ? Theme.accent : root.entry.binding == "None" ? Theme.faint : Theme.text;
                font-size: 12px;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
        bind := TouchArea {
            mouse-cursor: pointer;
            // Right-click clears on press (upstream behaviour); left binds on click so a
            // drag starting on a binding still scrolls instead of opening capture.
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                    Controls.clear-binding(root.entry.id, root.pad);
                }
            }
            clicked => { Controls.begin-capture(root.entry.id, root.pad); }
        }
    }
    property <bool> capturing: Controls.listening && Controls.capture-id == root.entry.id;
}

// Section title + rows of one tab, in the order the C++ side sends them.
component TabRows inherits VerticalLayout {
    in property <[ControlRow]> rows;
    in property <bool> pad;
    alignment: start;
    for row in root.rows: VerticalLayout {
        if row.section-start: Text {
            height: 30px;
            text: row.section;
            color: Theme.muted;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: bottom;
        }
        BindingRow { entry: row; pad: root.pad; }
        Rectangle {
            height: 1px;
            background: Theme.tint(0.05);
        }
    }
}

export component ControlsPage inherits Rectangle {
    callback close();
    background: Theme.bg;

    // Clicks that miss the page's own controls stop here instead of reaching the library under it.
    TouchArea { }

    VerticalLayout {
        // Explicit size: without it the page sizes to content preferred height, the
        // ScrollView never constrains (it grows with content), nothing scrolls and the
        // bottom action row is pushed off-screen.
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        padding: 18px;
        padding-left: 24px;
        padding-right: 24px;
        spacing: 10px;

        // Title and the way back to the library. Back button FIRST (left): a control
        // after growing content gets pushed off-screen; leading position is immune.
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                AppButton {
                    width: 110px;
                    text: "← Library";
                    clicked => { root.close(); }
                }
            }
            Text {
                text: "Controls";
                color: Theme.text;
                font-size: 20px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            // No stretch spacer: in this unbounded context it evaluates to infinity and
            // pushes everything after it off-screen. Tabs pack left instead.
            spacing: 4px;
            TabHeader { text: "Gamepad"; active: Controls.tab == 0; clicked => { if (!Controls.listening) { Controls.tab = 0; } } }
            TabHeader { text: "Keyboard & Mouse"; active: Controls.tab == 1; clicked => { if (!Controls.listening) { Controls.tab = 1; } } }
        }

        // Save / Cancel / Restore live here (not at the page bottom): the list below
        // can grow taller than the window, which would push bottom-anchored actions
        // off-screen with no way to reach them. The tip gets its own full-width line
        // so it can never squeeze the buttons out.
        Text {
            text: Controls.notice != "" ? Controls.notice : "Tip: right-click a binding to unmap it.";
            color: Controls.notice != "" ? Theme.danger : Theme.muted;
            font-size: 12px;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                AppButton {
                    width: 150px;
                    text: "Restore Defaults";
                    clicked => { Controls.restore-defaults(Controls.tab == 0); }
                }
            }
            VerticalLayout {
                alignment: center;
                AppButton {
                    width: 100px;
                    text: "Cancel";
                    clicked => { Controls.cancel(); }
                }
            }
            VerticalLayout {
                alignment: center;
                AppButton {
                    width: 100px;
                    text: "Save";
                    primary: true;
                    clicked => { Controls.save(); }
                }
            }
            // Manual list scroll (wheel/drag/scrollbar are unreliable here): steps the
            // active tab's list by 120px. Lives here (not next to the list) because
            // only this row reliably paints all its buttons.
            VerticalLayout {
                alignment: center;
                AppButton {
                    width: 100px;
                    text: "Up";
                    clicked => {
                        if (Controls.tab == 0) {
                            Controls.gamepad-y = min(0px, Controls.gamepad-y + 120px);
                        } else {
                            Controls.keyboard-y = min(0px, Controls.keyboard-y + 120px);
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                AppButton {
                    width: 100px;
                    text: "Down";
                    clicked => {
                        // No lower clamp available here (the ScrollView ids are invisible
                        // outside their `if`); Flickable clamps the rest. -1200px covers
                        // the tallest list with room to spare.
                        if (Controls.tab == 0) {
                            Controls.gamepad-y = max(-1200px, Controls.gamepad-y - 120px);
                        } else {
                            Controls.keyboard-y = max(-1200px, Controls.keyboard-y - 120px);
                        }
                    }
                }
            }
        }

        // The emulated touch pad: shared by both tabs, as in upstream. Sits above
        // the list (not below): below-list content gets pushed off-screen when the
        // list grows, with no way to scroll the page itself.
        Rectangle {
            height: 56px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            border-radius: 0px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Emulated touch pad";
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Particle skin";
                        color: Theme.muted;
                        font-size: 12px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Dropdown {
                        width: 150px;
                        model: ["Classic", "Blue neon", "Monochrome", "Crimson", "Red/Blue"];
                        current-index <=> Controls.skin-index;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    AppCheckBox {
                        text: "Show hand cursor and trail";
                        checked <=> Controls.show-cursor;
                    }
                }
                // (No stretch spacer before the hint: it pushes followers off-screen.)
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Toggle with the touch pad mode key (F6); draw with left mouse / Cross.";
                        color: Theme.muted;
                        font-size: 11px;
                    }
                }
            }
        }

        // The tab's own list.
        Rectangle {
            vertical-stretch: 1;
            background: transparent;

            if Controls.tab == 0: VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                spacing: 6px;

                Text {
                    // Fixed height: VBox children grow by default and tall help text
                    // pushes the list off-screen.
                    height: 20px;
                    text: "Choose which button on your gamepad triggers each PS5 control. Click a binding, then press the button or trigger you want to use.";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    height: 20px;
                    text: Controls.status;
                    color: Theme.text;
                    font-size: 12px;
                }
                Text {
                    height: 18px;
                    text: "Older/fork builds may exit with 'Invalid input mapping' when a Pad: binding is set.";
                    color: Theme.faint;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                gamepad-scroll := ScrollView {
                    // Bounded height so the list scrolls instead of pushing everything
                    // below off-screen. max-height (not height): short content stays short.
                    // Drag-pan enabled (the style disables it): wheel alone may not reach.
                    // content-y bound to the global (same value the action-row buttons step):
                    // ids inside `if` are invisible outside it, globals are not.
                    max-height: 400px;
                    mouse-drag-pan-enabled: true;
                    content-width: self.visible-width;
                    content-y <=> Controls.gamepad-y;
                    TabRows { width: gamepad-scroll.visible-width; rows: Controls.gamepad-rows; pad: true; }
                }
            }

            if Controls.tab == 1: VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                spacing: 6px;

                Text {
                    text: "Choose which keyboard key or mouse button triggers each PS5 control. Click a binding, then press the key or mouse button.";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                // Sensitivity above the list (not below): below-list content gets
                // pushed off-screen when the list grows.
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "Mouse sensitivity";
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        width: 130px;
                    }
                    VerticalLayout {
                        alignment: center;
                        AppSlider {
                            width: 220px;
                            minimum: 0.1;
                            maximum: 5.0;
                            step: 0.1;
                            value <=> Controls.sensitivity;
                            changed(value) => { Controls.sensitivity-edited(value); }
                        }
                    }
                    Text {
                        text: Controls.sensitivity-text;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        width: 48px;
                    }
                    Text {
                        text: "F7 in-game toggles mouse movement on the right stick.";
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                keyboard-scroll := ScrollView {
                    // Fixed height: see gamepad-scroll above.
                    height: 300px;
                    mouse-drag-pan-enabled: true;
                    content-width: self.visible-width;
                    content-y <=> Controls.keyboard-y;
                    TabRows { width: keyboard-scroll.visible-width; rows: Controls.keyboard-rows; pad: false; }
                }
            }
        }
    }

    // Capture: the page keeps its input, the overlay only says what to press.
    if Controls.listening: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.scrim;
        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
        }
        Rectangle {
            width: min(460px, root.width - 48px);
            height: capture-box.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 3;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            border-radius: 0px;
            capture-box := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "Set binding — " + Controls.capture-label;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: Controls.capture-message;
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if Controls.capture-pad: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Or pick one from the list:";
                        color: Theme.muted;
                        font-size: 12px;
                    }
                    Dropdown {
                        model: Controls.pad-sources;
                        selected => { Controls.pick-source(self.current-index); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    AppButton {
                        text: "Cancel";
                        clicked => { Controls.cancel-capture(); }
                    }
                }
            }
        }
    }
}
