// Controls page: the PS5 controls mapped to keyboard keys / mouse buttons and to gamepad buttons.
// The Qt launcher's Controls dialog, as a page: two tabs, click a binding then press, right-click clears.
// Laid out like the dialog: the sections as framed groups in a grid, a controller diagram on the right
// (the hovered or captured control lights up; clicking a part starts its capture), the emulated touch
// pad below, and Restore Defaults / Save / Cancel along the bottom.

import { ScrollView } from "std-widgets.slint";
import { Theme, Card, Dropdown, AppButton, AppCheckBox, AppSlider } from "common.slint";
import { TabButton } from "version_manager.slint";

// One row: a PS5 control and the binding it shows.
export struct ControlRow {
    id: string,
    label: string,
    binding: string,     // as shown ("None" when unbound)
    section: string,
    section-start: bool, // first row of its section
}

// State of the page (the C++ side fills it when the page opens).
export global Controls {
    in-out property <int> tab: 0; // 0 = Gamepad, 1 = Keyboard & Mouse
    in property <[ControlRow]> gamepad-rows;
    in property <[ControlRow]> keyboard-rows;
    in property <[string]> pad-sources; // labels of every gamepad button / trigger, table order
    in property <bool> listening;       // a capture is running: the overlay is up
    in property <string> capture-id;    // the row being captured
    in property <bool> capture-pad;     // the capture started on the gamepad tab (tabs lock while listening)
    in property <string> capture-label; // its control label, for the overlay title
    in property <string> capture-message;
    in property <string> status; // "Connected: Controller 1" / "No controller connected"
    in-out property <string> notice;
    in-out property <float> sensitivity: 1.0;
    in property <string> sensitivity-text: "1.0×";
    in-out property <int> skin-index: 0;
    in-out property <bool> show-cursor: true;
    // The control under the mouse, in the list or on the diagram (UI only): both light it up.
    in-out property <string> hover-id;
    // What the gamepad is pressing right now, as "|Cross|L2|": those rows and parts light up while held.
    in property <string> live;
    in property <float> left-x; // the sticks' positions, -1..1 (y down): the diagram's caps follow them
    in property <float> left-y;
    in property <float> right-x;
    in property <float> right-y;

    public pure function is-live(id: string) -> bool {
        return id != "" && self.live.replace-all("|" + id + "|", "") != self.live;
    }

    callback opened();
    callback begin-capture(string, bool); // control id, gamepad tab
    callback clear-binding(string, bool);
    callback pick-source(int); // index in pad-sources
    callback restore-defaults(bool); // gamepad tab
    callback sensitivity-edited(float);
    callback cancel-capture();
    callback save();
    callback cancel();
    callback close();
}

// Sizes of the grid: every group is the same width so the columns line up.
global Grid {
    out property <length> label-w: 172px;
    out property <length> button-w: 138px;
    out property <length> row-h: 26px;
    out property <length> row-gap: 6px;
    out property <length> card-w: 340px; // label + gap + button + the Card's padding and border
    out property <length> gap: 14px;
    out property <length> diagram-w: 480px; // the diagram's full size; it shrinks to the room left
    out property <length> diagram-h: 330px;
}

// Label on the left, the binding button on the right. Click binds, right-click clears (upstream's behaviour).
// A row of another section is collapsed to nothing (a group shows only its own section's rows).
component BindingRow inherits Rectangle {
    in property <ControlRow> entry;
    in property <bool> pad;
    in property <bool> shown: true;
    property <bool> capturing: Controls.listening && Controls.capture-id == root.entry.id;
    property <bool> lit: root.capturing || Controls.hover-id == root.entry.id;
    property <bool> live: root.pad && Controls.is-live(root.entry.id);
    property <bool> hovered: bind.has-hover;
    visible: root.shown;
    height: root.shown ? Grid.row-h + Grid.row-gap : 0px;

    changed hovered => {
        if (root.hovered) {
            Controls.hover-id = root.entry.id;
        } else if (Controls.hover-id == root.entry.id) {
            Controls.hover-id = "";
        }
    }

    Text {
        x: 2px;
        y: 0px;
        width: Grid.label-w - 2px;
        height: Grid.row-h;
        text: root.entry.label;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: Grid.label-w + 8px;
        y: 0px;
        width: Grid.button-w;
        height: Grid.row-h;
        border-radius: 0px;
        border-width: 1px;
        border-color: root.lit || root.live ? Theme.accent : Theme.card-border;
        background: root.live ? Theme.accent : bind.has-hover ? Theme.control-hover : Theme.log-bg;
        Text {
            x: 6px;
            width: parent.width - 12px;
            text: root.capturing ? "Press…" : root.entry.binding;
            color: root.live ? Theme.on-accent : root.capturing ? Theme.accent : root.entry.binding == "None" ? Theme.faint : Theme.text;
            font-size: 12px;
            font-weight: root.live ? 700 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        bind := TouchArea {
            mouse-cursor: pointer;
            // Right-click clears on press (upstream behaviour); left binds on click.
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                    Controls.clear-binding(root.entry.id, root.pad);
                }
            }
            clicked => { Controls.begin-capture(root.entry.id, root.pad); }
        }
    }
}

// One framed group: the rows of one section, in the order the C++ side sends them.
component Section inherits Card {
    in property <[ControlRow]> rows;
    in property <bool> pad;
    in property <string> section;
    title: root.section;
    width: Grid.card-w;
    VerticalLayout {
        spacing: 0px;
        padding-bottom: -Grid.row-gap; // the last row's gap; the Card pads the bottom itself
        for row in root.rows: BindingRow {
            entry: row;
            pad: root.pad;
            shown: row.section == root.section;
        }
    }
}

// An empty slot in a grid row, so a short row keeps its columns.
component Gap inherits Rectangle {
    width: Grid.card-w;
}

// ---- The controller diagram: upstream's DualSenseWidget (src/launcher/dualsenseWidget.cpp), its paths and
// layout copied onto a 480 x 330 canvas (upstream's, moved down 20 so the shoulders start at 0), scaled by k. ----

// One control of the diagram: its box on the canvas and its outline (an SVG path on the box), as upstream's
// CONTROLS table has them. Hovered, selected (captured) or held on the gamepad, it lights up.
component Part inherits Rectangle {
    in property <string> id;
    in property <float> k: 1;
    in property <float> x0; // the box, in canvas units
    in property <float> y0;
    in property <float> w;
    in property <float> h;
    in property <string> shape; // the outline, on the box
    in property <string> glyph; // a symbol stroked over it (face buttons, D-pad arrows, Options)
    in property <string> label; // shoulders
    in property <float> label-x: -1; // where the label is centred, on the box (-1 = the middle)
    in property <float> label-y: -1;
    in property <bool> ghost; // drawn only while lit (the stick directions and the touch pad halves)
    in property <float> cap; // a stick: the diameter of the cap, which moves with the stick
    in property <float> cap-x; // the stick's position, -1..1
    in property <float> cap-y;
    in property <bool> clickable: true; // clicking starts the capture (keyboard-only controls: that tab only)
    in property <string> tip;
    property <bool> live: Controls.tab == 0 && Controls.is-live(root.id);
    property <bool> active: root.live || touch.has-hover || Controls.hover-id == root.id
        || (Controls.listening && Controls.capture-id == root.id);
    property <brush> fill: root.live ? Theme.accent : root.active ? Theme.accent-soft : Theme.card;
    property <brush> ink: root.active ? Theme.accent-hover : Theme.muted;
    property <bool> hovered: touch.has-hover;
    x: root.x0 * root.k * 1px;
    y: root.y0 * root.k * 1px;
    width: root.w * root.k * 1px;
    height: root.h * root.k * 1px;

    changed hovered => {
        if (root.hovered) {
            Controls.hover-id = root.id;
        } else if (Controls.hover-id == root.id) {
            Controls.hover-id = "";
        }
    }

    Path {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        viewbox-width: root.w;
        viewbox-height: root.h;
        visible: !root.ghost || root.active;
        commands: root.shape;
        stroke: root.ink;
        stroke-width: 1.3px;
        fill: root.cap > 0 ? Theme.card : root.fill;
    }
    if root.cap > 0: Rectangle {
        // Upstream moves the cap up to 5 units towards the stick's direction.
        property <float> len: max(1, sqrt(root.cap-x * root.cap-x + root.cap-y * root.cap-y));
        width: root.cap * root.k * 1px;
        height: self.width;
        x: (parent.width - self.width) / 2 + root.cap-x / self.len * 5 * root.k * 1px;
        y: (parent.height - self.height) / 2 + root.cap-y / self.len * 5 * root.k * 1px;
        border-radius: self.width / 2;
        border-width: 1.3px;
        border-color: root.ink;
        background: root.fill;
    }
    if root.glyph != "": Path {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        viewbox-width: root.w;
        viewbox-height: root.h;
        commands: root.glyph;
        stroke: root.live ? Theme.on-accent : root.active ? Theme.accent-hover : Theme.text;
        stroke-width: 1.3px;
        fill: transparent;
    }
    if root.label != "": Text {
        x: root.label-x < 0 ? (parent.width - self.width) / 2 : root.label-x * root.k * 1px - self.width / 2;
        y: root.label-y < 0 ? (parent.height - self.height) / 2 : root.label-y * root.k * 1px - self.height / 2;
        text: root.label;
        color: root.live ? Theme.on-accent : root.active ? Theme.accent-hover : Theme.text;
        font-size: max(7px, 9px * root.k);
        font-weight: 700;
    }
    if root.tip != "": Tooltip {
        text: @markdown("\{root.tip}");
    }
    touch := TouchArea {
        mouse-cursor: root.clickable ? pointer : default;
        clicked => {
            if (root.clickable && !Controls.listening) {
                Controls.begin-capture(root.id, Controls.tab == 0);
            }
        }
    }
}

component ControllerDiagram inherits Rectangle {
    in property <float> k: 1;
    width: 480px * root.k;
    height: 330px * root.k;

    // The shell, the panel seams into the grips, the touch pad surface, Create (unmapped upstream) and the PS button.
    Path {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
