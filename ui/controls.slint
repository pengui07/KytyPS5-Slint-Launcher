    Part { k: root.k; id: "L3"; tip: "L3 (left stick click)"; x0: 143; y0: 151; w: 66; h: 66; shape: "M 0 33 A 33 33 0 1 0 66 33 A 33 33 0 1 0 0 33 Z"; cap: 42; cap-x: Controls.left-x; cap-y: Controls.left-y; }
