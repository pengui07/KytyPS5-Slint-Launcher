// First launch: where the launcher keeps its data, where the saves go, and whether to bring over the Qt launcher's
// settings. Shown before the main window exists (see run_first_run_setup in main.cpp); nothing is written until
// Continue, and closing the window keeps the choices it shows.
// The path defaults below are only sample data for the live preview: C++ sets every property before showing it.

import { Button, CheckBox } from "std-widgets.slint";
import { Theme } from "common.slint";

// One exclusive choice: a radio dot, a title and the folder it means (or why the choice is off).
component ChoiceRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback picked();

    min-height: 44px;
    border-radius: 6px;
    background: root.selected ? Theme.row-selected : touch.has-hover && root.enabled ? Theme.row-hover : transparent;
    opacity: root.enabled ? 1 : 0.5;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                // A thick accent ring reads as a filled radio dot without a second shape.
                border-width: root.selected ? 5px : 1.5px;
                border-color: root.selected ? Theme.accent : Theme.faint;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 1px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
            }
            // Only laid out when there is something to say: a hidden Text still takes its height.
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.picked();
            }
        }
    }
}

// A group heading: the name and, fainter, what lives there.
component SectionLabel inherits HorizontalLayout {
    in property <string> name;
    in property <string> hint;
    spacing: 8px;
    padding-left: 10px;
    padding-bottom: 2px;
    Text {
        text: root.name;
        color: Theme.muted;
        font-size: 11px;
        font-weight: 700;
    }
    Text {
        text: root.hint;
        color: Theme.faint;
        font-size: 11px;
        overflow: elide;
        horizontal-stretch: 1;
    }
}

export component FirstRunWindow inherits Window {
    title: "KytyPS5 Launcher";
    icon: @image-url("icons/app-icon.png");
    preferred-width: 620px;
    min-width: 540px;
    background: Theme.bg;
    default-font-size: 13px;

    // The per-user root: configs, versions, cache and logs unless the portable one is chosen.
    in property <string> app-data-root: "C:\\Users\\you\\AppData\\Local\\KytyPS5";
    // The launcher's own folder (the .app bundle's parent on macOS): the portable root, where portable.txt goes.
    in property <string> portable-root: "D:\\Games\\KytyPS5 Launcher";
    in property <bool> portable-enabled: true;
    in property <string> portable-disabled-reason; // a read-only folder, say: why the portable choice is off
    in-out property <bool> portable-selected: false;
    // <root>\run for each data root: the saves folder that goes with the choice above.
    in property <string> app-data-run-dir: "C:\\Users\\you\\AppData\\Local\\KytyPS5\\run";
    in property <string> portable-run-dir: "D:\\Games\\KytyPS5 Launcher\\run";
    out property <string> default-run-dir: root.portable-selected ? root.portable-run-dir : root.app-data-run-dir;
    // The Qt launcher, when one of its settings files was found.
    in property <bool> qt-found: false;
    in property <string> qt-ini-path;
    in property <string> qt-run-dir; // its emulator folder, where _SaveData and _Trophies already are
    in property <bool> qt-run-dir-available: false;
    // 0 = with the launcher data, 1 = the Qt launcher's folder, 2 = a folder the user picked.
    in-out property <int> run-choice: 0;
    in-out property <string> picked-run-dir;
    in-out property <bool> import-qt: false;

    // The saves folder the choices add up to; C++ reads it once the window is closed.
    out property <string> chosen-run-dir: root.run-choice == 2 ? root.picked-run-dir : root.run-choice == 1 ? root.qt-run-dir : root.default-run-dir;

    callback continue-clicked();
    callback pick-run-dir();

    VerticalLayout {
        padding: 24px;
        padding-bottom: 20px;
        spacing: 2px;

        Text {
            text: "Welcome to KytyPS5 Launcher";
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
        }
        Text {
            text: "Choose where your files go. You can change both later in Settings > Paths.";
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }

        Rectangle { height: 18px; }

        SectionLabel {
            name: "LAUNCHER DATA";
            hint: "settings, downloaded versions, cache, logs";
        }
        ChoiceRow {
            title: "App data (recommended)";
            detail: root.app-data-root;
            selected: !root.portable-selected;
            picked => {
                root.portable-selected = false;
            }
        }
        ChoiceRow {
            title: "Next to the launcher (portable)";
            detail: root.portable-enabled ? root.portable-root : root.portable-disabled-reason;
            selected: root.portable-selected;
            enabled: root.portable-enabled;
            picked => {
                root.portable-selected = true;
            }
        }

        Rectangle { height: 14px; }

        SectionLabel {
            name: "SAVES";
            hint: "where games keep _SaveData and _Trophies";
        }
        if root.qt-run-dir-available: ChoiceRow {
            title: "Keep the Qt launcher's folder";
            detail: root.qt-run-dir;
            selected: root.run-choice == 1;
            picked => {
                root.run-choice = 1;
            }
        }
        ChoiceRow {
            title: "With the launcher data";
            detail: root.default-run-dir;
            selected: root.run-choice == 0;
            picked => {
                root.run-choice = 0;
            }
        }
        ChoiceRow {
            title: root.run-choice == 2 && root.picked-run-dir != "" ? "Another folder" : "Another folder...";
            detail: root.run-choice == 2 ? root.picked-run-dir : "";
            selected: root.run-choice == 2;
            picked => {
                root.pick-run-dir();
            }
        }

        if root.qt-found: HorizontalLayout {
            padding-top: 14px;
            padding-left: 8px;
            VerticalLayout {
                spacing: 1px;
                CheckBox {
                    text: "Import settings and games from the Qt launcher";
                    checked: root.import-qt;
                    toggled => {
                        root.import-qt = self.checked;
                    }
                }
                HorizontalLayout {
                    padding-left: 28px;
                    Text {
                        text: root.qt-ini-path;
                        color: Theme.faint;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
            }
        }

        Rectangle { height: 20px; }

        HorizontalLayout {
            alignment: end;
            Button {
                text: "Continue";
                primary: true;
                clicked => {
                    root.continue-clicked();
                }
            }
        }
    }
}
