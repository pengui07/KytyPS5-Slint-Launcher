// First launch: where the launcher keeps its data, where the saves go, and whether to bring over the Qt launcher's
// settings. Shown before the main window exists (see run_first_run_setup in main.cpp); nothing is written until
// Continue, and closing the window keeps the choices it shows.

import { Button, CheckBox } from "std-widgets.slint";
import { Theme } from "common.slint";

// One exclusive choice: a dot, a title and a detail line (the folder, or why the choice is off).
component ChoiceRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback picked();

    height: 52px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.card-border;
    background: root.selected ? Theme.row-selected : touch.has-hover ? Theme.row-hover : Theme.card;
    opacity: root.enabled ? 1 : 0.55;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 1px;
                border-color: root.selected ? Theme.accent : Theme.faint;
                background: transparent;
                Rectangle {
                    x: 4px;
                    y: 4px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                    visible: root.selected;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
            }
            Text {
                text: root.detail;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
                visible: root.detail != "";
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (root.enabled) {
                root.picked();
            }
        }
    }
}

export component FirstRunWindow inherits Window {
    title: "KytyPS5 Launcher - first launch";
    icon: @image-url("icons/app-icon.png");
    preferred-width: 700px;
    preferred-height: 660px;
    min-width: 620px;
    min-height: 560px;
    background: Theme.bg;
    default-font-size: 13px;

    // The per-user root: configs, versions, cache and logs unless the portable one is chosen.
    in property <string> app-data-root;
    // The launcher's own folder (the .app bundle's parent on macOS): the portable root, where portable.txt goes.
    in property <string> portable-root;
    in property <bool> portable-enabled: true;
    in property <string> portable-disabled-reason; // a read-only folder, say: why the portable choice is off
    in-out property <bool> portable-selected: false;
    // <root>\run for each data root: the saves folder that goes with the choice above.
    in property <string> app-data-run-dir;
    in property <string> portable-run-dir;
    out property <string> default-run-dir: root.portable-selected ? root.portable-run-dir : root.app-data-run-dir;
    // The Qt launcher, when one of its settings files was found.
    in property <bool> qt-found: false;
    in property <string> qt-ini-path;
    in property <string> qt-run-dir; // its emulator folder, where _SaveData and _Trophies already are
    in property <bool> qt-run-dir-available: false;
    // 0 = with the launcher data, 1 = the Qt launcher's folder, 2 = a folder the user picked.
    in-out property <int> run-choice: 0;
    in-out property <string> picked-run-dir;
    in-out property <bool> import-qt: false;

    // The saves folder the choices add up to; C++ reads it once the window is closed.
    out property <string> chosen-run-dir: root.run-choice == 2 ? root.picked-run-dir : root.run-choice == 1 ? root.qt-run-dir : root.default-run-dir;

    callback continue-clicked();
    callback pick-run-dir();

    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        Text {
            text: "Where should KytyPS5 keep its files?";
            color: Theme.text;
            font-size: 19px;
            font-weight: 700;
        }
        Text {
            text: "The launcher remembers this. Both folders can be changed later in Settings > Paths.";
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }

        Text {
            text: "Launcher data";
            color: Theme.text;
            font-weight: 600;
        }
        Text {
            text: "Configs, downloaded versions, cache and logs.";
            color: Theme.muted;
            font-size: 11px;
        }
        ChoiceRow {
            title: "This PC's app data";
            detail: root.app-data-root;
            selected: !root.portable-selected;
            picked => {
                root.portable-selected = false;
            }
        }
        ChoiceRow {
            title: "Next to the launcher (portable)";
            detail: root.portable-enabled ? root.portable-root : root.portable-disabled-reason;
            selected: root.portable-selected;
            enabled: root.portable-enabled;
            picked => {
                root.portable-selected = true;
            }
        }

        Text {
            text: "Saves";
            color: Theme.text;
            font-weight: 600;
        }
        Text {
            text: "_SaveData and _Trophies are kept in this folder (the emulator's working folder).";
            color: Theme.muted;
            font-size: 11px;
        }
        ChoiceRow {
            title: "With the launcher data";
            detail: root.default-run-dir;
            selected: root.run-choice == 0;
            picked => {
                root.run-choice = 0;
            }
        }
        if root.qt-run-dir-available: ChoiceRow {
            title: "Keep using the Qt launcher's folder";
            detail: root.qt-run-dir;
            selected: root.run-choice == 1;
            picked => {
                root.run-choice = 1;
            }
        }
        ChoiceRow {
            title: "Choose a folder...";
            detail: root.run-choice == 2 && root.picked-run-dir != "" ? root.picked-run-dir : "Any folder on this PC.";
            selected: root.run-choice == 2;
            picked => {
                root.pick-run-dir();
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.card-border;
        }

        if root.qt-found: VerticalLayout {
            spacing: 2px;
            CheckBox {
                text: "Import the settings from the Qt launcher";
                checked: root.import-qt;
                toggled => {
                    root.import-qt = self.checked;
                }
            }
            Text {
                text: root.qt-ini-path;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: transparent;
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Text {
                text: "Nothing is written until Continue.";
                color: Theme.faint;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: "Continue";
                clicked => {
                    root.continue-clicked();
                }
            }
        }
    }
}
