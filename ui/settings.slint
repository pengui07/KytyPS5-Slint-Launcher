import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, ThemedEdit, IconButton, TextCell, HeaderCell, Chevron, Dropdown, AppButton, AppCheckBox, AppSlider, AppSpinBox } from "common.slint";
import { VM, TabButton } from "version_manager.slint";

export struct ToggleItem {
    env: string,
    label: string,
    hint: string,
    on: bool,
}

// A row of the Games tab: one library game and its emulator pin.
export struct GameConfigRow {
    name: string,
    serial: string,
    game-version: string,
    emu: string,         // "None", the pinned build's name, "<name> (missing)", or "-" for a game without a serial
    emu-missing: bool,   // the pinned exe is gone
    pinned: bool,
    can-config: bool,    // false without a title id: no pin and no per-game settings
    custom: bool,        // the game has its own settings (an "emu" block in its file)
    pin: int,            // the pinned build's index in the pin choices after "Library default" (-1: none or missing)
    icon: image,
}

// A build the pin picker lists (every installed build, not filtered by the Version Manager's search).
export struct BuildChoice {
    name: string,
    path: string,
}

// STEP7:2: one row of the Games tab's "Removed games" list: a game taken off the library with
// "Remove from list" (its files are still on disk, and it stays in the saved list until restored).
export struct RemovedGameRow {
    label: string,  // the game's folder or file name, or its title id when the entry has no path
    detail: string, // the saved key: the title id, or the path it was removed by
}

// STEP6:6e: one row of the environment variable table (Settings > Advanced, global and per-game mode).
export struct EnvVar {
    name: string,
    value: string,
}

// STEP6:6e: the environment table lives in a global so that C++ owns the rows (a model) without the launcher
// window having to forward every edit. Row indices are the model's.
export global EnvEditor {
    in property <[EnvVar]> vars;
    callback edited(int, string, string); // row, name, value (both as typed: C++ only trims on save)
    callback removed(int);
    callback added();
}

// STEP6:6e: the microphone and GPU pickers. C++ fills these when the page opens and on Refresh; empty lists
// mean the page keeps its plain text fields (macOS and Linux, or when nothing was detected).
export global Devices {
    in property <[string]> audio-inputs;   // "Default (system)" first, then the detected input devices
    in property <[string]> gpu-choices;    // "Auto" first, then the Vulkan devices in enumeration order
    in-out property <int> gpu-choice: 0;   // index in gpu-choices; 0 = Auto (the emulator's gpu index -1)
    callback refresh();                    // page opened: use the session's list (enumerate on first use)
    callback rescan();                     // "Refresh" button: look for the devices again
}

// STEP6:6e: per-game actions of the Settings > Games tab that the launcher window handles: it draws the
// confirmation dialogs (a row index is a library index, the Games tab lists the library in order).
export global GameActions {
    callback delete-save-data(int);
}

// Sizes shared by the form rows, so the controls of every group line up.
global Form {
    out property <length> label-w: 140px; // the label column
    out property <length> row-h: 26px;
    out property <length> gap: 10px;     // between groups, and between the two columns
}


// A settings group: a filled box with its title inside, at the top. `hint` is what the title explains on hover.
// Side by side in a row, the boxes share the width equally and take the height of the tallest.
component Section inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <bool> fill: false; // a child with vertical-stretch takes the height left (a table)
    horizontal-stretch: 1;
    preferred-width: 0px;
    background: Theme.card;
    border-width: 1px;
    border-radius: 0px;
    border-color: Theme.card-border;
    VerticalLayout {
        padding: 14px;
        padding-top: 12px;
        spacing: 6px;
        alignment: root.fill ? LayoutAlignment.stretch : LayoutAlignment.start;
        Rectangle {
            height: 22px;
            Text {
                x: 0px;
                width: self.preferred-width;
                height: parent.height;
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
            if root.hint != "": Tooltip {
                text: @markdown("\{root.hint}");
            }
        }
        @children
    }
}

// Grey text after a control: a unit ("%", "s") or a few words.
component Unit inherits Text {
    color: Theme.muted;
    font-size: 13px;
    vertical-alignment: center;
}

// The label and its control(s), which fill the rest of the row.
// A label column entry: hovering it shows the row's explanation.
component RowLabel inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    width: Form.label-w;
    height: 100%;
    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.hint != "": Tooltip {
        text: @markdown("\{root.hint}");
    }
}

component FormRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 8px;
    min-height: Form.row-h;
    RowLabel {
        text: root.label;
        hint: root.hint;
    }
    @children
}

// A text setting.
component Field inherits FormRow {
    in property <string> placeholder;
    in-out property <string> text <=> edit.text;
    edit := ThemedEdit {
        horizontal-stretch: 1;
        placeholder: root.placeholder;
    }
}

// A folder or file setting with Browse.
component PathField inherits FormRow {
    in property <string> placeholder;
    in-out property <string> text <=> edit.text;
    callback browse();
    edit := ThemedEdit {
        horizontal-stretch: 1;
        placeholder: root.placeholder;
    }
    AppButton {
        text: "Browse…";
        clicked => { root.browse(); }
    }
}

// A row of the game folder list: a kind tag, then the path.
component FolderRow inherits Rectangle {
    in property <string> path;
    in property <bool> selected: false;
    callback clicked();
    height: 26px;
    border-radius: 0px;
    background: root.selected ? Theme.row-selected : touch.has-hover ? Theme.row-hover : transparent;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: root.path;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A row of the Games tab, laid out like a library row.
component GameConfigRowView inherits Rectangle {
    in property <GameConfigRow> game;
    in property <bool> selected;
    in property <[string]> emu-choices; // "Library default", then every installed build
    in property <length> name-w;
    in property <length> serial-w;
    in property <length> version-w;
    in property <length> settings-w;
    in property <length> emu-w;
    callback clicked();
    callback double-clicked();
    callback menu(length, length); // right-click, in window coordinates
    callback set-emu(int);         // the Emulator drop-down: a build's index in the pin list, -1 for the library default
    height: 44px;
    background: root.selected ? Theme.row-selected : touch.has-hover ? Theme.row-hover : transparent;
    // The selected row's marker, as in the drop-down lists.
    if root.selected: Rectangle {
        x: 0px;
        width: 2px;
        height: parent.height;
        background: Theme.accent;
    }

    HorizontalLayout {
        spacing: 0px;
        padding-left: 10px;
        padding-right: 10px;
        HorizontalLayout {
            width: root.name-w;
            padding-left: 6px;
            padding-right: 8px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: Theme.log-bg;
                    clip: true;
                    Image {
                        source: root.game.icon;
                        image-fit: cover;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: root.game.name;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        TextCell { w: root.serial-w; text: root.game.serial == "" ? "—" : root.game.serial; }
        TextCell { w: root.version-w; text: root.game.game-version == "" ? "—" : root.game.game-version; }
        TextCell {
            w: root.settings-w;
            text: !root.game.can-config ? "—" : root.game.custom ? "Custom" : "Global";
            color: root.game.custom ? Theme.text : Theme.muted;
        }
        // The Emulator column: a drop-down of the library default and every installed build, filling the cell.
        // The row's TouchArea opens it (see below).
        VerticalLayout {
            width: root.emu-w;
            alignment: center;
            padding-left: 4px;
            emu-cell := Dropdown {
                height: 30px;
                flat: true;
                enabled: root.game.can-config;
                model: root.emu-choices;
                current-index: root.game.pin + 1;
                popup-width: max(root.emu-w - 4px, 220px);
                text: !root.game.can-config ? "—" : root.game.pinned ? root.game.emu : "Library default";
                text-color: root.game.emu-missing ? Theme.danger : root.game.pinned ? Theme.text : Theme.muted;
                selected(i) => { root.set-emu(i - 1); }
            }
        }
    }

    touch := TouchArea {
        clicked => {
            // A click in the Emu column opens its drop-down; anywhere else selects the row.
            if (self.mouse-x >= emu-cell.absolute-position.x - root.absolute-position.x) {
                emu-cell.open();
            } else {
                root.clicked();
            }
        }
        double-clicked => { root.double-clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.clicked();
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// Grey help text inside a group.
component Hint inherits Text {
    color: Theme.muted;
    font-size: 12px;
    wrap: word-wrap;
}

// An on/off setting: a checkbox, its hint in grey after it, the variable or flag in the tooltip.
// `tag` is a small boxed label after the text (EXPERIMENTAL), `note` grey text at the right end of the row.
component ToggleRow inherits Rectangle {
    in property <ToggleItem> item;
    in property <bool> enabled: true;
    in property <string> tag;
    in property <string> note;
    callback toggled(bool);
    horizontal-stretch: 1;
    HorizontalLayout {
        spacing: 8px;
        min-height: 26px;
        AppCheckBox {
            horizontal-stretch: 0;
            text: root.item.label;
            enabled: root.enabled;
            checked: root.item.on;
            toggled => { root.toggled(self.checked); }
        }
        if root.tag != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: tag-text.preferred-width + 10px;
                height: 16px;
                border-width: 1px;
                border-radius: 0px;
                border-color: Theme.card-border;
                tag-text := Text {
                    text: root.tag;
                    color: Theme.muted;
                    font-size: 10px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.note != "": Text {
            text: root.note;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    if root.item.hint != "" || root.item.env != "": Tooltip {
        text: root.item.hint != ""
            ? @markdown("\{root.item.hint}")
            : @markdown("`\{root.item.env}`");
    }
}

// The Settings page. The window keeps the values (the C++ side talks to it) and binds them to these.
export component SettingsPage inherits VerticalLayout {
    in-out property <bool> amd-cpu;
    in-out property <bool> cmd-dump;
    in-out property <string> cmd-dump-folder;
    in-out property <int> console-language;
    in-out property <string> extra-args;
    in property <[string]> game-dir-list;
    in-out property <int> game-dir-selected;
    in-out property <string> gpu-text;
    // General and Controller cards (the Qt launcher's options, same defaults).
    in-out property <bool> fullscreen;
    in-out property <bool> hide-cursor;
    in-out property <bool> perf-panel;
    in-out property <bool> skip-boot-logos;
    in-out property <bool> trophy: true;
    in-out property <int> trophy-duration: 6; // seconds
    in-out property <string> controller-color; // "#rrggbb", empty = the default lightbar
    in property <color> controller-swatch; // controller-color as a colour (the C++ side parses it)
    in-out property <int> controller-vibration: 100;
    in-out property <int> controller-volume: 50;
    in-out property <int> keyboard-player: 0;
    in-out property <bool> hdr;
    in-out property <string> height-text;
    in property <bool> is-windows;
    // Per-game mode: the page edits one game's overrides (the C++ side loads the game's resolved values into
    // the same properties) and hides the launcher-only settings.
    in property <bool> game-mode;
    in property <string> game-mode-name;
    in property <string> game-mode-serial;
    // Games tab.
    in property <[GameConfigRow]> game-configs;
    in-out property <int> games-selected: -1;
    // STEP7:2: the games taken off the library ("Remove from list"), and the row selected here.
    in property <[RemovedGameRow]> removed-games;
    in-out property <int> removed-selected: -1;
    // STEP7:3: check for newer "-latest" builds at startup and every hour (Settings > General).
    in-out property <bool> check-updates: true;
    in-out property <length> gw-serial: 110px;
    in-out property <length> gw-version: 110px;
    in-out property <length> gw-settings: 100px;
    in-out property <length> gw-emu: 300px;
    in property <[string]> pin-choices;      // the Emulator drop-downs: "Library default", then the installed builds
    property <bool> selected-can-config: root.games-selected >= 0 && root.games-selected < root.game-configs.length
        && root.game-configs[root.games-selected].can-config;
    property <bool> selected-pinned: root.selected-can-config && root.game-configs[root.games-selected].pinned;
    in-out property <string> microphone;
    in-out property <int> present-mode;
    in-out property <int> printf-dir;
    in-out property <string> printf-file;
    in-out property <bool> profiler;
    in-out property <bool> readback;
    in-out property <bool> readback-tiled;
    in-out property <bool> network-connected;
    in-out property <string> addons-dir;
    in-out property <bool> red-zone;
    in-out property <bool> renderdoc;
    in-out property <string> run-dir;
    in property <bool> running; // a game is running: the Games tab locks its save-data delete
    in-out property <int> settings-tab;
    in-out property <int> shader-log;
    in-out property <string> shader-log-folder;
    in-out property <int> shader-opt;
    in-out property <bool> shader-validation;
    in-out property <bool> sync-raw;
    in-out property <bool> occlusion-queries;
    in-out property <bool> shader-cache: true;
    in-out property <bool> gpu-assisted-validation;
    in-out property <bool> graphics-debug-dump;
    in-out property <bool> spirv-debug-printf;
    in-out property <bool> splash: true;
    in-out property <bool> vr;
    in-out property <bool> playgo-hack;
    in-out property <bool> tessellation;
    in-out property <string> user-id-text;
    in-out property <string> user-name;
    in-out property <string> vblank-text;
    in-out property <bool> vulkan-validation;
    in property <int> recommended-size; // the Window size preset that matches the monitor (-1: none)
    in-out property <string> width-text;
    // Window size picker: the matching preset, or 5 (Custom) when the size isn't a preset.
    in-out property <int> size-index: width-text == "1280" && height-text == "720" ? 0
        : width-text == "1600" && height-text == "900" ? 1
        : width-text == "1920" && height-text == "1080" ? 2
        : width-text == "2560" && height-text == "1440" ? 3
        : width-text == "3840" && height-text == "2160" ? 4 : 5;

    callback back();
    callback browse-game-dir();
    callback browse-run-dir();
    callback delete-cache-requested();
    callback remove-game-dir(int);
    callback save();
    callback controller-color-edited(string);
    callback browse-addons-dir();
    // Goes back to the library; edits already made stay until the launcher closes.
    callback discard();
    callback games-opened();                 // the Games tab was shown: refresh its rows
    callback open-game-settings(int);        // Games tab row -> per-game mode
    callback clear-game-emu(int);            // pin "None"
    callback pick-game-emu(int);             // "Set emulator..." (the window shows the picker)
    callback set-game-emu(int, int);         // the Emulator drop-down: library index, build index (-1: library default)
    callback restore-game(int);              // STEP7:2: Games tab: put a removed game back on the library
    callback reset-game();                   // per-game mode: drop the game's overrides

    changed settings-tab => {
        if (self.settings-tab == 4) {
            root.games-opened();
        }
    }

    // STEP6:6e: fill the microphone and GPU pickers when the page opens (their Refresh buttons redo it).
    changed visible => {
        if (self.visible) {
            Devices.refresh();
        }
    }

    padding: 12px;
    padding-top: 10px;
    spacing: 10px;

    // Tabs on a strip: full-width 1px bottom border like Qt Fusion / shadPS4.
    Rectangle {
        height: 28px;
        // The band behind the tabs runs to the window edges, ignoring the page padding, as in the reference.
        Rectangle {
            x: -12px;
            y: -10px;
            width: parent.width + 24px;
            height: parent.height + 10px;
            background: Theme.bg;
        }
        // Full-width 1px bottom line under the tab bar
        Rectangle {
            x: -12px;
            y: parent.height - 1px;
            width: parent.width + 24px;
            height: 1px;
            background: Theme.card-border;
        }
        HorizontalLayout {
            spacing: 2px;
            // Back first (not after a stretch spacer): a stretch here evaluates to
            // infinity and pushes the back button off-screen, trapping the user.
            VerticalLayout {
                alignment: center;
                AppButton {
                    width: 110px;
                    height: 28px;
                    text: "← Library";
                    clicked => { root.back(); }
                }
            }
            // Shown in this order; `tab` is the settings-tab number (Games is 4 wherever it sits).
            for tab in root.game-mode
                ? [{ label: "General", tab: 0 }, { label: "Graphics", tab: 1 }, { label: "Advanced", tab: 2 }, { label: "Debug", tab: 3 }]
                : [{ label: "General", tab: 0 }, { label: "Graphics", tab: 1 }, { label: "Games", tab: 4 }, { label: "Advanced", tab: 2 }, { label: "Debug", tab: 3 }]: TabButton {
                // Fixed width (not fill): HBox children grow by default and push
                // later tabs off-screen.
                width: 110px;
                text: tab.label;
                active: tab.tab == root.settings-tab;
                clicked => { root.settings-tab = tab.tab; }
            }
        }
    }

    // Per-game mode: which game is being edited.
    if root.game-mode: Rectangle {
        height: 30px;
        background: Theme.accent-soft;
        border-radius: 0px;
        Text {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: "Editing settings for " + root.game-mode-name + " (" + root.game-mode-serial + ") - only changes from your global settings are saved";
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // General tab: cards in rows of two, each pair the same height, and the game folders across the bottom.
    if root.settings-tab == 0: general-view := ScrollView {
        vertical-stretch: 1;
        content-width: self.visible-width;
        general-col := VerticalLayout {
            // One column of a row: rows share these widths, so the cards line up from row to row.
            property <length> half: (self.width - self.padding-right - Form.gap) / 2;
            width: general-view.visible-width;
            padding-top: 8px;
            padding-right: 12px;
            padding-bottom: 4px;
            spacing: Form.gap;
            alignment: start;
            HorizontalLayout {
                spacing: Form.gap;
                Section {
                    width: general-col.half;
                    title: "User profile";
                    Field {
                        label: "User name";
                        placeholder: "Kyty";
                        text <=> root.user-name;
                    }
                    FormRow {
                        label: "User ID";
                        ThemedEdit {
                            width: 120px;
                            placeholder: "1000";
                            text <=> root.user-id-text;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    FormRow {
                        label: "Console language";
                        Dropdown {
                            horizontal-stretch: 1;
                            model: ["Japanese", "English (United States)", "French (France)", "Spanish (Spain)", "German", "Italian", "Dutch", "Portuguese (Portugal)", "Russian", "Korean", "Chinese (Traditional)", "Chinese (Simplified)", "Finnish", "Swedish", "Danish", "Norwegian", "Polish", "Portuguese (Brazil)", "English (United Kingdom)", "Turkish", "Spanish (Latin America)", "Arabic", "French (Canada)", "Czech", "Hungarian", "Greek", "Romanian", "Thai", "Vietnamese", "Indonesian"];
                            current-index <=> root.console-language;
                        }
                    }
                }
                Section {
                    width: general-col.half;
                    title: "Controller & audio";
                    FormRow {
                        label: "DualSense lightbar";
                        // The colour as hex text, with a swatch of it; empty (or not a colour) = the default lightbar.
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-width: 1px;
                                border-radius: 0px;
                                border-color: Theme.card-border;
                                background: root.controller-swatch;
                            }
                        }
                        ThemedEdit {
                            width: 110px;
                            placeholder: "Default";
                            text <=> root.controller-color;
                            edited(text) => { root.controller-color-edited(text); }
                        }
                        AppButton {
                            text: "Reset";
                            enabled: root.controller-color != "";
                            clicked => {
                                root.controller-color = "";
                                root.controller-color-edited("");
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    // AppSpinBox (not AppSlider): AppSlider does not paint here
                    // (thumb/value missing in all variants tried); SpinBox does.
                    FormRow {
                        label: "Vibration";
                        AppSpinBox {
                            width: 90px;
                            minimum: 0;
                            maximum: 100;
                            value <=> root.controller-vibration;
                        }
                        Unit { text: "%"; }
                    }
                    FormRow {
                        label: "Speaker volume";
                        AppSpinBox {
                            width: 90px;
                            minimum: 0;
                            maximum: 100;
                            value <=> root.controller-volume;
                        }
                        Unit { text: "%"; }
                    }
                    // STEP6:6e: the detected input devices as a menu next to the editable name (typing keeps
                    // working: the emulator also accepts a name the system doesn't list).
                    FormRow {
                        label: "Microphone";
                        hint: "The detected input devices. Default (system) leaves the choice to Windows; a name brought over from Kyty.ini shows even when its device is not plugged in.";
                        // Opens "Default (system)" and the detected devices; the box shows the current name even
                        // when its device is not plugged in, so the list does not track a selection.
                        Dropdown {
                            horizontal-stretch: 1;
                            tracks-selection: false;
                            model: Devices.audio-inputs;
                            text: root.microphone;
                            placeholder: "Default (system)";
                            selected(i) => { root.microphone = i == 0 ? "" : Devices.audio-inputs[i]; }
                        }
                    }
                    FormRow {
                        label: "Keyboard controls";
                        Dropdown {
                            horizontal-stretch: 1;
                            model: ["Player 1 (shared)", "Player 1", "Player 2", "Player 3", "Player 4"];
                            current-index <=> root.keyboard-player;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: Form.gap;
                Section {
                    width: general-col.half;
                    title: "General";
                    ToggleRow {
                        item: { env: "--fullscreen", label: "Run in fullscreen", hint: "", on: root.fullscreen };
                        toggled(on) => { root.fullscreen = on; }
                    }
                    ToggleRow {
                        item: { env: "--hide-cursor", label: "Auto-hide cursor", hint: "", on: root.hide-cursor };
                        toggled(on) => { root.hide-cursor = on; }
                    }
                    ToggleRow {
                        item: { env: "--perf-overlay (F2 toggles it, Shift+F2 shows the detailed view)", label: "Show performance panel", hint: "", on: root.perf-panel };
                        note: "F2 toggles in game";
                        toggled(on) => { root.perf-panel = on; }
                    }
                    ToggleRow {
                        item: { env: "--skip-notice-screen", label: "Skip boot logos", hint: "", on: root.skip-boot-logos };
                        toggled(on) => { root.skip-boot-logos = on; }
                    }
                    ToggleRow {
                        item: { env: "--no-splash", label: "Show the startup splash screen", hint: "The emulator's own splash while a game boots. Off passes `--no-splash`.", on: root.splash };
                        toggled(on) => { root.splash = on; }
                    }
                    ToggleRow {
                        item: { env: "--network-connected", label: "Network connected", hint: "", on: root.network-connected };
                        toggled(on) => { root.network-connected = on; }
                    }
                    // The duration sits on the notifications' own line, outside the row's tooltip.
                    HorizontalLayout {
                        spacing: 6px;
                        ToggleRow {
                            item: { env: "--no-trophy-notifications", label: "Trophy notifications", hint: "", on: root.trophy };
                            toggled(on) => { root.trophy = on; }
                        }
                        Unit { text: "show for"; }
                        AppSpinBox {
                            width: 70px;
                            minimum: 5;
                            maximum: 10;
                            enabled: root.trophy;
                            value <=> root.trophy-duration;
                        }
                        Unit { text: "s"; }
                    }
                }
                VerticalLayout {
                    width: general-col.half;
                    spacing: Form.gap;
                    Section {
                        title: "Compatibility";
                        vertical-stretch: 0;
                        ToggleRow {
                            item: { env: "--amd-cpu", label: "AMD CPU patch", hint: "", on: root.amd-cpu };
                            tag: "EXPERIMENTAL";
                            toggled(on) => { root.amd-cpu = on; }
                        }
                        // Windows only: shown everywhere, greyed out elsewhere.
                        ToggleRow {
                            enabled: root.is-windows;
                            item: { env: "--redzone", label: "Red zone crash protection", hint: "Protects the Windows SysV red zone (experimental).", on: root.red-zone };
                            tag: "EXPERIMENTAL";
                            note: "Windows only";
                            toggled(on) => { root.red-zone = on; }
                        }
                        ToggleRow {
                            item: { env: "--playgo-hack", label: "PlayGo stub fallback", hint: "Use the supplied PlayGo stub fallback. `--playgo-hack`", on: root.playgo-hack };
                            tag: "EXPERIMENTAL";
                            toggled(on) => { root.playgo-hack = on; }
                        }
                        ToggleRow {
                            item: { env: "--vr", label: "Virtual VR headset", hint: "Enable the emulator's virtual VR headset. `--vr`", on: root.vr };
                            tag: "EXPERIMENTAL";
                            toggled(on) => { root.vr = on; }
                        }
                    }
                    // Launcher settings, saved with the others (not per game).
                    if !root.game-mode: Section {
                        title: "Launcher";
                        vertical-stretch: 1;
                        FormRow {
                            label: "Theme";
                            Dropdown {
                                horizontal-stretch: 1;
                                model: ["Dark", "Light", "Classic"];
                                current-index <=> Theme.scheme;
                            }
                        }
                        // STEP7:3: the Version Manager's automatic check for newer "-latest" builds.
                        ToggleRow {
                            item: { env: "check_updates", label: "Check for emulator updates on startup",
                            hint: "Looks for a newer build of every \"-latest\" folder when the launcher starts, and every hour while it stays open. Off: nothing is fetched in the background; Update in the Version Manager still works.",
                            on: root.check-updates };
                            toggled(on) => { root.check-updates = on; }
                        }
                    }
                }
            }
            if !root.game-mode: Section {
                title: "Game folders";
                hint: "The folders scanned for games, the folder the emulator runs in, and the shared add-ons folder.";
                // Split on the same line as the rows above: the list under the left cards, the paths under the right.
                HorizontalLayout {
                    spacing: Form.gap + 28px;
                    VerticalLayout {
                        width: general-col.half - 28px;
                        spacing: 6px;
                        Rectangle {
                            height: 120px;
                            background: Theme.log-bg;
                            border-width: 1px;
                            border-radius: 0px;
                            border-color: Theme.card-border;
                            clip: true;
                            ScrollView {
                                VerticalLayout {
                                    alignment: start;
                                    padding: 4px;
                                    for dir[i] in root.game-dir-list: FolderRow {
                                        path: dir;
                                        selected: i == root.game-dir-selected;
                                        clicked => { root.game-dir-selected = i; }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            AppButton {
                                text: "Add folder…";
                                clicked => { root.browse-game-dir(); }
                            }
                            AppButton {
                                text: "Remove";
                                enabled: root.game-dir-selected >= 0 && root.game-dir-selected < root.game-dir-list.length;
                                clicked => { root.remove-game-dir(root.game-dir-selected); }
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        alignment: start;
                        PathField {
                            label: "Run folder";
                            hint: "Save data, flags.ctl and the logs go in the run folder.";
                            text <=> root.run-dir;
                            browse => { root.browse-run-dir(); }
                        }
                        FormRow {
                            label: "Add-ons (DLC) folder";
                            hint: "One folder holding the extracted add-ons (DLC), shared by every game.";
                            ThemedEdit {
                                horizontal-stretch: 1;
                                placeholder: "None";
                                text <=> root.addons-dir;
                            }
                            AppButton {
                                text: "Browse…";
                                clicked => { root.browse-addons-dir(); }
                            }
                            if root.addons-dir != "": AppButton {
                                text: "Clear";
                                clicked => { root.addons-dir = ""; }
                            }
                        }
                    }
                }
            }
        }
    }

    // Graphics, Advanced and Debug are laid out like General: cards in rows of two, each pair the same height.
    if root.settings-tab == 1: graphics-view := ScrollView {
        vertical-stretch: 1;
        content-width: self.visible-width;
        graphics-col := VerticalLayout {
            property <length> half: (self.width - self.padding-right - Form.gap) / 2;
            width: graphics-view.visible-width;
            padding-top: 8px;
            padding-right: 12px;
            padding-bottom: 4px;
            spacing: Form.gap;
            alignment: start;
            HorizontalLayout {
                spacing: Form.gap;
                Section {
                    width: graphics-col.half;
                    title: "Display";
                    FormRow {
                        label: "Screen resolution";
                        Dropdown {
                            horizontal-stretch: 1;
                            model: [
                                "1280 x 720" + (root.recommended-size == 0 ? " (recommended)" : ""),
                                "1600 x 900" + (root.recommended-size == 1 ? " (recommended)" : ""),
                                "1920 x 1080" + (root.recommended-size == 2 ? " (recommended)" : ""),
                                "2560 x 1440" + (root.recommended-size == 3 ? " (recommended)" : ""),
                                "3840 x 2160" + (root.recommended-size == 4 ? " (recommended)" : ""),
                                "Custom"
                            ];
                            current-index <=> root.size-index;
                            selected(value) => {
                                if (self.current-index == 0) { root.width-text = "1280"; root.height-text = "720"; }
                                else if (self.current-index == 1) { root.width-text = "1600"; root.height-text = "900"; }
                                else if (self.current-index == 2) { root.width-text = "1920"; root.height-text = "1080"; }
                                else if (self.current-index == 3) { root.width-text = "2560"; root.height-text = "1440"; }
                                else if (self.current-index == 4) { root.width-text = "3840"; root.height-text = "2160"; }
                            }
                        }
                    }
                    if root.size-index == 5: FormRow {
                        label: "Custom size";
                        ThemedEdit {
                            width: 90px;
                            placeholder: "width";
                            text <=> root.width-text;
                        }
                        Unit { text: "x"; }
                        ThemedEdit {
                            width: 90px;
                            placeholder: "height";
                            text <=> root.height-text;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    FormRow {
                        label: "Present mode";
                        Dropdown {
                            horizontal-stretch: 1;
                            model: ["Fifo", "Mailbox", "Immediate"];
                            current-index <=> root.present-mode;
                        }
                    }
                    FormRow {
                        label: "Vblank frequency";
                        ThemedEdit {
                            width: 90px;
                            placeholder: "60";
                            text <=> root.vblank-text;
                        }
                        Unit { text: "Hz"; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    ToggleRow {
                        item: { env: "--hdr", label: "HDR display support", hint: "HDR10 output for supported games. Needs HDR turned on for the host display. `--hdr`", on: root.hdr };
                        toggled(on) => { root.hdr = on; }
                    }
                }
                Section {
                    width: graphics-col.half;
                    title: "GPU";
                    // STEP6:6e: the Vulkan devices as a picker ("Auto" = the emulator's default, -1); a typed
                    // index stays possible while nothing was detected.
                    if Devices.gpu-choices.length > 1: FormRow {
                        label: "Device";
                        Dropdown {
                            horizontal-stretch: 1;
                            model: Devices.gpu-choices;
                            current-index <=> Devices.gpu-choice;
                            selected => {
                                // 0 = Auto (-1); the device at index N is the emulator's --gpu index N - 1.
                                root.gpu-text = self.current-index <= 0 ? "" : "\{self.current-index - 1}";
                            }
                        }
                        AppButton {
                            text: "Refresh";
                            clicked => { Devices.rescan(); }
                        }
                    }
                    if Devices.gpu-choices.length <= 1: FormRow {
                        label: "Device";
                        ThemedEdit {
                            horizontal-stretch: 1;
                            placeholder: "Auto";
                            text <=> root.gpu-text;
                        }
                        AppButton {
                            text: "Refresh";
                            clicked => { Devices.rescan(); }
                        }
                    }
                    ToggleRow {
                        item: { env: "--shader-cache", label: "Cache shaders", hint: "Save compiled shaders and pipelines per game and load them at startup. `--shader-cache`", on: root.shader-cache };
                        toggled(on) => { root.shader-cache = on; }
                    }
                    ToggleRow {
                        item: { env: "--occlusion-queries", label: "Occlusion queries", hint: "Count the samples of occlusion queries on the GPU, so hidden lights and objects stay hidden. Costs some performance. `--occlusion-queries`", on: root.occlusion-queries };
                        toggled(on) => { root.occlusion-queries = on; }
                    }
                    ToggleRow {
                        item: { env: "--tessellation", label: "Tessellation", hint: "Draw tessellated geometry. Off by default: unsupported tessellation may crash. `--tessellation`", on: root.tessellation };
                        tag: "EXPERIMENTAL";
                        toggled(on) => { root.tessellation = on; }
                    }
                }
            }
            HorizontalLayout {
                spacing: Form.gap;
                Section {
                    width: graphics-col.half;
                    title: "Image readback";
                    ToggleRow {
                        item: { env: "--readback-linear-images", label: "Readback", hint: "Read back writable linear images on submit. `--readback-linear-images`", on: root.readback };
                        toggled(on) => { root.readback = on; }
                    }
                    ToggleRow {
                        item: { env: "--readback-tiled-images", label: "Tiled readback", hint: "Read back small writable tiled images on submit. `--readback-tiled-images`", on: root.readback-tiled };
                        toggled(on) => { root.readback-tiled = on; }
                    }
                }
                Section {
                    width: graphics-col.half;
                    title: "Rendering compatibility";
                    ToggleRow {
                        item: { env: "--sync-raw-image-buffers", label: "Accurate texture synchronization", hint: "Synchronizes raw reads of GPU images. Can fix missing textures and wrong transparency (Resident Evil 2). `--sync-raw-image-buffers`", on: root.sync-raw };
                        toggled(on) => { root.sync-raw = on; }
                    }
                    Hint {
                        text: "May fix rendering bugs, at a slight performance cost.";
                    }
                }
            }
        }
    }

    if root.settings-tab == 2: advanced-view := ScrollView {
        vertical-stretch: 1;
        content-width: self.visible-width;
        advanced-col := VerticalLayout {
            property <length> half: (self.width - self.padding-right - Form.gap) / 2;
            width: advanced-view.visible-width;
            padding-top: 8px;
            padding-right: 12px;
            padding-bottom: 4px;
            spacing: Form.gap;
            alignment: start;
            HorizontalLayout {
                spacing: Form.gap;
                alignment: start;
                VerticalLayout {
                    width: advanced-col.half;
                    spacing: Form.gap;
                    Section {
                        title: "Launch";
                        vertical-stretch: 0;
                        Field {
                            label: "Extra arguments";
                            placeholder: "e.g. --no-async-pipelines";
                            text <=> root.extra-args;
                        }
                    }
                    // STEP6:6e: the env table of the emulator process (kyty.json "emu" / "env"), in global and
                    // per-game mode. C++ owns the rows: it appends, removes and re-reads them on save.
                    Section {
                        title: "Environment variables";
                        vertical-stretch: 1;
                        hint: "Empty value removes the variable. Names: letters, digits, underscore.";
                        for v[i] in EnvEditor.vars: HorizontalLayout {
                            spacing: 8px;
                            ThemedEdit {
                                horizontal-stretch: 1;
                                placeholder: "NAME";
                                text: v.name;
                                edited(text) => { EnvEditor.edited(i, text, v.value); }
                            }
                            ThemedEdit {
                                horizontal-stretch: 2;
                                placeholder: "value";
                                text: v.value;
                                edited(text) => { EnvEditor.edited(i, v.name, text); }
                            }
                            AppButton {
                                text: "Remove";
                                clicked => { EnvEditor.removed(i); }
                            }
                        }
                        if EnvEditor.vars.length == 0: Hint {
                            text: "No variables yet: the emulator inherits the launcher's environment.";
                        }
                        HorizontalLayout {
                            alignment: start;
                            AppButton {
                                text: "Add variable";
                                clicked => { EnvEditor.added(); }
                            }
                        }
                    }
                }
                // The Version Manager's GitHub access: the token and the cached release lists. Launcher-wide, so
                // not shown for a game.
                if !root.game-mode: Section {
                    width: advanced-col.half;
                    title: "GitHub";
                    hint: "Without a token GitHub allows 60 release-list requests an hour; with one, 5000. Private repositories need Contents: Read-only. Without one, the GITHUB_TOKEN or GH_TOKEN environment variable is used. A saved token is encrypted in the system credential store and cannot be shown again.";
                    if !VM.gh-token-set: FormRow {
                        label: "Token";
                        token-edit := ThemedEdit {
                            horizontal-stretch: 1;
                            input-type: InputType.password;
                            placeholder: "ghp_… or github_pat_…";
                            accepted => {
                                VM.gh-token-changed(self.text);
                                self.text = "";
                            }
                        }
                        AppButton {
                            text: "Save";
                            primary: true;
                            enabled: token-edit.text != "";
                            clicked => {
                                VM.gh-token-changed(token-edit.text);
                                token-edit.text = "";
                            }
                        }
                    }
                    if VM.gh-token-set: FormRow {
                        label: "Token";
                        // Only the start of the token, to tell which one is saved.
                        Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.log-bg;
                            border-color: Theme.card-border;
                            border-width: 1px;
                            border-radius: 0px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: VM.gh-token-hint;
                                    font-family: "Consolas";
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: VM.gh-token-storable ? "Encrypted" : "This session only";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        AppButton {
                            text: "Clear";
                            clicked => { VM.gh-token-changed(""); }
                        }
                    }
                    Hint {
                        text: "Optional. Raises GitHub's limit from 60 to 5000 release-list requests an hour.";
                    }
                    FormRow {
                        label: "Release list cache";
                        hint: "Release lists are saved on disk and reused for 10 minutes, then rechecked with GitHub.";
                        Unit {
                            horizontal-stretch: 1;
                            text: VM.cache-info;
                            font-size: 12px;
                            overflow: elide;
                        }
                        AppButton {
                            text: "Delete cache";
                            enabled: !VM.busy;
                            clicked => { root.delete-cache-requested(); }
                        }
                    }
                }
            }
        }
    }

    if root.settings-tab == 3: debug-view := ScrollView {
        vertical-stretch: 1;
        content-width: self.visible-width;
        debug-col := VerticalLayout {
            property <length> half: (self.width - self.padding-right - Form.gap) / 2;
            width: debug-view.visible-width;
            padding-top: 8px;
            padding-right: 12px;
            padding-bottom: 4px;
            spacing: Form.gap;
            alignment: start;
            HorizontalLayout {
                spacing: Form.gap;
                Section {
                    width: debug-col.half;
                    title: "Validation";
                    ToggleRow {
                        item: { env: "--vulkan-validation", label: "Vulkan validation", hint: "", on: root.vulkan-validation };
                        toggled(on) => { root.vulkan-validation = on; }
                    }
                    ToggleRow {
                        item: { env: "--shader-validation", label: "Shader validation", hint: "", on: root.shader-validation };
                        toggled(on) => { root.shader-validation = on; }
                    }
                    ToggleRow {
                        item: { env: "--gpu-assisted-validation", label: "GPU-assisted validation", hint: "Bounds-check shader accesses on the GPU. Turns on Vulkan validation too; very slow. `--gpu-assisted-validation`", on: root.gpu-assisted-validation };
                        note: "Very slow";
                        toggled(on) => { root.gpu-assisted-validation = on; }
                    }
                    ToggleRow {
                        item: { env: "--spirv-debug-printf", label: "SPIR-V debug printf", hint: "", on: root.spirv-debug-printf };
                        toggled(on) => { root.spirv-debug-printf = on; }
                    }
                }
                Section {
                    width: debug-col.half;
                    title: "Logging";
                    FormRow {
                        label: "Shader logging";
                        Dropdown {
                            horizontal-stretch: 1;
                            model: ["Silent", "Console", "File"];
                            current-index <=> root.shader-log;
                        }
                    }
                    Field {
                        label: "Shader log folder";
                        placeholder: "<run folder>\\shaders";
                        text <=> root.shader-log-folder;
                    }
                    FormRow {
                        label: "Printf output";
                        Dropdown {
                            horizontal-stretch: 1;
                            model: ["Silent", "Console", "File"];
                            current-index <=> root.printf-dir;
                        }
                    }
                    Field {
                        label: "Printf output file";
                        placeholder: "_kyty.txt";
                        text <=> root.printf-file;
                    }
                }
            }
            HorizontalLayout {
                spacing: Form.gap;
                Section {
                    width: debug-col.half;
                    title: "Capture & profiling";
                    ToggleRow {
                        item: { env: "--rd", label: "RenderDoc capture", hint: "", on: root.renderdoc };
                        toggled(on) => { root.renderdoc = on; }
                    }
                    ToggleRow {
                        item: { env: "--profile", label: "Tracy profiler", hint: "", on: root.profiler };
                        toggled(on) => { root.profiler = on; }
                    }
                    ToggleRow {
                        item: { env: "--graphics-debug-dump", label: "Graphics debug dump", hint: "", on: root.graphics-debug-dump };
                        toggled(on) => { root.graphics-debug-dump = on; }
                    }
                }
                Section {
                    width: debug-col.half;
                    title: "Command buffers";
                    ToggleRow {
                        item: { env: "--command-buffer-dump", label: "Command buffer dump", hint: "", on: root.cmd-dump };
                        toggled(on) => { root.cmd-dump = on; }
                    }
                    Field {
                        label: "Dump folder";
                        placeholder: "_Buffers";
                        text <=> root.cmd-dump-folder;
                    }
                }
            }
        }
    }

    // Games: every library game with its emulator pin; each can also open its own settings. The games card takes
    // the page's height, the removed games card only the height of its rows.
    if root.settings-tab == 4 && !root.game-mode: VerticalLayout {
        vertical-stretch: 1;
        padding-top: 8px;
        spacing: Form.gap;
        Section {
            vertical-stretch: 1;
            fill: true;
            title: "Games (" + root.game-configs.length + ")";
            hint: "\"Library default\" runs the game with the emulator chosen in the library. Pinning a build runs that game with it instead; a \"-latest\" build follows its updates, a dated build stays exactly as it is. Pins and per-game settings are kept per serial.";
            games-box := Rectangle {
                vertical-stretch: 1;
                min-height: 160px;
                background: Theme.log-bg;
                border-radius: 0px;
                border-width: 1px;
                border-color: Theme.card-border;
                clip: true;
                // The Game column takes what the others leave, so the table always spans the card.
                property <length> fixed-w: 20px + root.gw-serial + root.gw-version + root.gw-settings + root.gw-emu;
                property <length> name-w: max(220px, self.width - 2px - self.fixed-w);
                // Right-click menu of the selected row (the row selects itself first). Only what fits the game.
                games-menu := ContextMenuArea {
                    x: 0px;
                    y: 0px;
                    width: 0px;
                    height: 0px;
                    Menu {
                        MenuItem {
                            title: "Game settings…";
                            icon: @image-url("icons/global-settings.svg");
                            enabled: root.selected-can-config;
                            activated => { root.open-game-settings(root.games-selected); }
                        }
                        MenuItem {
                            title: root.selected-pinned ? "Change emulator…" : "Set emulator…";
                            icon: @image-url("icons/pin.svg");
                            enabled: root.selected-can-config;
                            activated => { root.pick-game-emu(root.games-selected); }
                        }
                        if root.selected-pinned: MenuItem {
                            title: "Use library default";
                            icon: @image-url("icons/clear.svg");
                            activated => { root.clear-game-emu(root.games-selected); }
                        }
                    }
                }
                VerticalLayout {
                    padding: 1px;
                    // The header follows the rows' horizontal scroll.
                    Rectangle {
                        height: 30px;
                        clip: true;
                        HorizontalLayout {
                            x: games-table.content-x;
                            width: games-box.name-w + games-box.fixed-w;
                            height: parent.height;
                            spacing: 0px;
                            padding-left: 10px;
                            padding-right: 10px;
                            // No grip on Game: it fills the space the other columns leave.
                            Text {
                                width: games-box.name-w;
                                text: "Game";
                                color: Theme.muted;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            HeaderCell { text: "Serial"; w <=> root.gw-serial; }
                            HeaderCell { text: "Version"; w <=> root.gw-version; }
                            HeaderCell { text: "Settings"; w <=> root.gw-settings; tooltip: "Custom: the game has its own settings (Game settings…). Global: it uses yours."; }
                            // Lined up with the text inside the drop-downs below.
                            HorizontalLayout {
                                width: root.gw-emu;
                                padding-left: 14px;
                                Text {
                                    text: "Emulator";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.card-border;
                        }
                    }
                    games-table := ListView {
                        vertical-stretch: 1;
                        content-width: max(self.visible-width, games-box.name-w + games-box.fixed-w);
                        for game[index] in root.game-configs: GameConfigRowView {
                            width: games-box.name-w + games-box.fixed-w;
                            game: game;
                            emu-choices: root.pin-choices;
                            name-w: games-box.name-w;
                            serial-w: root.gw-serial;
                            version-w: root.gw-version;
                            settings-w: root.gw-settings;
                            emu-w: root.gw-emu;
                            selected: index == root.games-selected;
                            clicked => { root.games-selected = index; }
                            double-clicked => {
                                if (game.can-config) {
                                    root.open-game-settings(index);
                                }
                            }
                            menu(x, y) => {
                                games-menu.show({ x: x - games-menu.absolute-position.x, y: y - games-menu.absolute-position.y });
                            }
                            set-emu(build) => {
                                root.games-selected = index;
                                root.set-game-emu(index, build);
                            }
                        }
                    }
                }
                if root.game-configs.length == 0: Text {
                    text: "No games in the library. Add a game folder in General.";
                    color: Theme.muted;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            // The selected game's actions; the emulator ones change with its pin.
            HorizontalLayout {
                spacing: 8px;
                AppButton {
                    text: "Game settings…";
                    enabled: root.selected-can-config;
                    clicked => { root.open-game-settings(root.games-selected); }
                }
                AppButton {
                    text: root.selected-pinned ? "Change emulator…" : "Set emulator…";
                    enabled: root.selected-can-config;
                    clicked => { root.pick-game-emu(root.games-selected); }
                }
                if root.selected-pinned: AppButton {
                    text: "Use library default";
                    clicked => { root.clear-game-emu(root.games-selected); }
                }
                Rectangle { horizontal-stretch: 1; }
                // STEP6:6e: wipes <run folder>/_SaveData/<serial> of the selected game, after the launcher window's
                // confirmation. Games without a title id (a .zar archive, for one) have no save folder.
                AppButton {
                    text: "Delete save data…";
                    enabled: root.games-selected >= 0 && root.games-selected < root.game-configs.length
                        && root.game-configs[root.games-selected].serial != "" && !root.running;
                    clicked => { GameActions.delete-save-data(root.games-selected); }
                }
            }
        }

        // STEP7:2: what "Remove from list" took off the library. Nothing was deleted from disk; Restore puts the
        // game back in the library (the rescan finds it again).
        Section {
            vertical-stretch: 0;
            title: "Removed games (" + root.removed-games.length + ")";
            hint: "\"Remove from list\" only hides a game: its files stay where they are and it is listed here until restored.";
            if root.removed-games.length == 0: Hint {
                text: "Nothing removed.";
            }
            if root.removed-games.length > 0: Rectangle {
                // Up to four rows, then the list scrolls.
                height: min(4, root.removed-games.length) * 34px + 2px;
                background: Theme.log-bg;
                border-radius: 0px;
                border-width: 1px;
                border-color: Theme.card-border;
                clip: true;
                ListView {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    for game[i] in root.removed-games: Rectangle {
                        height: 34px;
                        background: removed-touch.has-hover ? Theme.row-hover : transparent;
                        removed-touch := TouchArea {
                            // Straight to the library, like the Restore button.
                            double-clicked => { root.restore-game(i); }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 4px;
                            spacing: 12px;
                            Text {
                                min-width: 0px;
                                text: game.label;
                                color: Theme.text;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                text: game.detail;
                                color: Theme.faint;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            VerticalLayout {
                                alignment: center;
                                AppButton {
                                    text: "Restore";
                                    clicked => { root.restore-game(i); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Bottom bar: crisp 1px top divider, Save and Discard on the left. (Games tab: nothing to save there, pins apply at once.)
    if !(root.settings-tab == 4 && !root.game-mode): VerticalLayout {
        spacing: 8px;
        Rectangle {
            height: 1px;
            background: Theme.card-border;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            AppButton {
                width: 110px;
                text: "Save";
                primary: true;
                clicked => { root.save(); }
            }
            // Drops the unsaved changes and goes back to the library.
            AppButton {
                width: 110px;
                text: "Discard";
                clicked => {
                    root.discard();
                    root.back();
                }
            }
            // Per-game mode: deletes the game's overrides (its emulator pin stays).
            if root.game-mode: AppButton {
                text: "Reset to global";
                clicked => { root.reset-game(); }
            }
        }
    }
}
