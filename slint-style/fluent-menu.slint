// The launcher's copy of Slint's fluent/menu.slint (v1.18.1), copied over the fetched one by
// CMakeLists.txt: Slint has no per-app menu styling. The window has no native frame, so the menu bar
// is the window's title bar, like the classic Steam client's: small grey menu titles after the app
// icon, and app.slint draws the icon and the window buttons over its two ends. A title is plain text that only
// brightens on hover or while its menu is open, with no box behind it.
// The popup menus are shaped like the shadPS4 launcher's: near-square corners, rows highlighted edge
// to edge in the accent colour, a slim frame.
// This file cannot see the launcher's Theme global, so it follows FluentPalette.color-scheme, which
// app.slint sets from Theme.light; the popup colours copy common.slint's Theme values (named beside
// them), light or dark. The classic theme gets the dark ones: color-scheme has no third value. The bar itself
// is transparent: AppWindow's background (Theme.panel) shows through it.

import { FluentPalette, FluentFontSettings } from "styling.slint";

// `open` is set by the launcher's copy of menus.slint (slint-style/menus.slint) while this entry's
// menu is showing.
export component MenuBarItem {
    in property <MenuEntry> entry;
    in property <bool> open;

    callback clicked;
    callback hovered;

    min-width: layout.min-width;
    min-height: layout.min-height;

    touch-area := TouchArea {
        layout := HorizontalLayout {
            padding-left: 2px;
            padding-right: 2px;

            label := Text {
                text: root.entry.title;
                color: touch-area.has-hover || root.open
                    ? (FluentPalette.color-scheme == ColorScheme.light ? #1a2130 : #ffffff)
                    : (FluentPalette.color-scheme == ColorScheme.light ? #586377 : #8b939f);
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.clicked();
            }
        }

        changed has-hover => {
            if self.has-hover {
                root.hovered();
            }
        }
    }
}

// The title bar row. 32px high, with the first title 36px in (room for the app icon): app.slint's
// TitleBar uses the same values. Each title takes clicks only 2px either side of its text, like
// Steam's, and the 12px gaps between them belong to the bar. Dragging anywhere on the bar moves the window.
export component MenuBar inherits Rectangle {
    min-height: max(32px, layout.min-height);
    background: transparent;

    WindowMoveArea {
        layout := HorizontalLayout {
            alignment: start;
            padding-left: 34px;
            spacing: 12px;

            @children
        }
    }
}

// Padding only above and below, so the highlighted row reaches both edges.
export component MenuFrame inherits Rectangle {
    property <bool> light: FluentPalette.color-scheme == ColorScheme.light;
    background: light ? #ffffff : #141923; // Theme.popup
    border-radius: 2px;
    border-width: 1px;
    border-color: light ? #c5ccd8 : #2b3345; // Theme.card-border
    drop-shadow-color: light ? #00000040 : #00000090;
    drop-shadow-offset-y: 4px;
    drop-shadow-blur: 10px;
    clip: true;
    min-width: max(200px, layout.min-width);

    layout := VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        padding-left: 1px;
        padding-right: 1px;
        @children
    }
}

// Slint's MenuItemBase (common/menu-base.slint, v1.18.1) with the icon column the launcher's game
// menu uses, like the shadPS4 launcher's: a 16 px icon before every title, drawn in the title's own
// colour (the launcher's icons are black outlines meant to be tinted, as on the toolbar), and greyed
// with the title when the entry is disabled. Menus without icons keep the empty column, so their
// titles line up the same way.
component IconMenuItemBase {
    in property <brush> default-foreground;
    in property <brush> alternate-foreground: default-foreground;
    in property <brush> current-foreground;
    in property <brush> current-background;
    in property <brush> separator-color;
    in property <length> border-radius <=> background-layer.border-radius;
    in property <bool> is-current;
    // Time at which the item was created, used to suppress accidental
    // activation from the mouse-up that opened the menu.
    property <duration> open-time;
    property <bool> had-press;
    init => { open-time = animation-tick(); }
    in property <MenuEntry> entry;
    in property <image> sub-menu-icon;
    in property <length> icon-size; // the sub-menu arrow
    in property <length> item-icon-size; // the entry's own icon, and the check mark's column
    in property <length> horizontal-padding;

    callback set-current();
    callback clear-current();
    callback activate(entry : MenuEntry, y: length);

    background-layer := Rectangle {
        touch-area := TouchArea {
            visible: !entry.is-separator;
            enabled: entry.enabled;

            layout := HorizontalLayout {
                padding-left: root.horizontal-padding;
                padding-right: root.horizontal-padding;
                spacing: 8px;

                Rectangle {
                    width: root.item-icon-size;

                    if entry.checked: Text {
                        text: "✓";
                        color: label.color;
                        opacity: label.opacity;
                    }

                    icon := Image {
                        source: entry.icon;
                        accessible-role: none;
                        image-fit: contain;
                        width: root.item-icon-size;
                        height: root.item-icon-size;
                        colorize: label.color;
                        opacity: label.opacity;
                    }
                }

                label := Text {
                    text: entry.title;
                    color: root.default-foreground;
                    vertical-alignment: center;
                }

                shortcut := Text {
                    text: entry.shortcut.to-string();
                    color: root.alternate-foreground;
                    vertical-alignment: center;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }

                if entry.has-sub-menu : Image {
                    width: root.icon-size;
                    y: (parent.height - self.height) / 2;
                    source: root.sub-menu-icon;
                    colorize: label.color;
                    accessible-role: none;
                }
            }

            pointer-event(event) => {
                if event.kind == PointerEventKind.move && !root.is-current {
                    root.set-current()
                } else if event.kind == PointerEventKind.down && entry.has-sub-menu && entry.enabled {
                    activate(entry, self.absolute-position.y);
                } else if event.kind == PointerEventKind.down {
                    // A deliberate press always enables activation
                    root.had-press = true;
                } else if event.kind == PointerEventKind.up
                        && (root.had-press || animation-tick() - root.open-time > 300ms)
                        && self.mouse-y > 0 && self.mouse-y < self.height
                        && self.mouse-x > 0 && self.mouse-x < self.width
                        && entry.enabled {
                    // can't put this in `clicked` because then the menu would close causing a panic in the pointer-event
                    activate(entry, self.absolute-position.y);
                }
            }

            changed has-hover => {
                if !self.has-hover && root.is-current {
                    root.clear-current();
                }
            }
        }

        if entry.is-separator: Rectangle {
            height: 1px;
            background: root.separator-color;
        }
    }

    states [
        is-current when root.is-current : {
            background-layer.background: root.current-background;
            label.color: root.current-foreground;
        }
        disabled when !entry.enabled : {
            label.opacity: 0.4;
        }
    ]
}

export component MenuItem {
    property <bool> light: FluentPalette.color-scheme == ColorScheme.light;
    in property <bool> is-current <=> base.is-current;
    in property <MenuEntry> entry <=> base.entry;

    callback set-current <=> base.set-current;
    callback clear-current <=> base.clear-current;
    callback activate <=> base.activate;

    min-height: entry.is-separator ? 9px : max(28px, base.min-height);
    max-height: entry.is-separator ? 9px : base.max-height;

    HorizontalLayout {
        padding-top: entry.is-separator ? 4px : 0px;
        padding-bottom: entry.is-separator ? 4px : 0px;

        base := IconMenuItemBase {
            // Theme.text, Theme.muted, Theme.on-accent, Theme.accent and Theme.card-border.
            default-foreground: light ? #1a2130 : #d0d7e6;
            alternate-foreground: light ? #586377 : #707b90;
            current-foreground: #ffffff;
            current-background: light ? #2b6fe0 : #3a86ff;
            separator-color: light ? #c5ccd8 : #2b3345;
            border-radius: 0px;
            horizontal-padding: 12px;
            sub-menu-icon: @image-url("_arrow_forward.svg");
            icon-size: 12px;
            item-icon-size: 16px;
        }
    }
}
