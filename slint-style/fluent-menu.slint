// The launcher's copy of Slint's fluent/menu.slint (v1.18.1), copied over the fetched one by
// CMakeLists.txt: Slint has no per-app menu styling. The window has no native frame, so the menu bar
// is the window's title bar, like the classic Steam client's: small grey menu titles after the app
// icon, and app.slint draws the icon and the window buttons over its two ends. A title is plain text that only
// brightens on hover or while its menu is open, with no box behind it.
// The popup menus are shaped like the shadPS4 launcher's: near-square corners, rows highlighted edge
// to edge in the accent colour, a slim frame.
// This file cannot see the launcher's Theme global, so it follows FluentPalette.color-scheme, which
// app.slint sets from Theme.light; the light values match common.slint's light palette. The bar itself
// is transparent: AppWindow's background (Theme.panel) shows through it.

import { FluentPalette, FluentFontSettings } from "styling.slint";
import { MenuItemBase } from "../common/menu-base.slint";

// `open` is set by the launcher's copy of menus.slint (slint-style/menus.slint) while this entry's
// menu is showing.
export component MenuBarItem {
    in property <MenuEntry> entry;
    in property <bool> open;

    callback clicked;
    callback hovered;

    min-width: layout.min-width;
    min-height: layout.min-height;

    touch-area := TouchArea {
        layout := HorizontalLayout {
            padding-left: 2px;
            padding-right: 2px;

            label := Text {
                text: root.entry.title;
                color: touch-area.has-hover || root.open
                    ? (FluentPalette.color-scheme == ColorScheme.light ? #1a2130 : #ffffff)
                    : (FluentPalette.color-scheme == ColorScheme.light ? #586377 : #8b939f);
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.clicked();
            }
        }

        changed has-hover => {
            if self.has-hover {
                root.hovered();
            }
        }
    }
}

// The title bar row. 32px high, with the first title 36px in (room for the app icon): app.slint's
// TitleBar uses the same values. Each title takes clicks only 2px either side of its text, like
// Steam's, and the 12px gaps between them belong to the bar. Dragging anywhere on the bar moves the window.
export component MenuBar inherits Rectangle {
    min-height: max(32px, layout.min-height);
    background: transparent;

    WindowMoveArea {
        layout := HorizontalLayout {
            alignment: start;
            padding-left: 34px;
            spacing: 12px;

            @children
        }
    }
}

// Padding only above and below, so the highlighted row reaches both edges.
export component MenuFrame inherits Rectangle {
    property <bool> light: FluentPalette.color-scheme == ColorScheme.light;
    background: light ? #ffffff : #1b1f27;
    border-radius: 2px;
    border-width: 1px;
    border-color: light ? #c5ccd8 : #2e3542;
    drop-shadow-color: light ? #00000040 : #00000090;
    drop-shadow-offset-y: 4px;
    drop-shadow-blur: 10px;
    clip: true;
    min-width: max(200px, layout.min-width);

    layout := VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        padding-left: 1px;
        padding-right: 1px;
        @children
    }
}

export component MenuItem {
    property <bool> light: FluentPalette.color-scheme == ColorScheme.light;
    in property <bool> is-current <=> base.is-current;
    in property <MenuEntry> entry <=> base.entry;

    callback set-current <=> base.set-current;
    callback clear-current <=> base.clear-current;
    callback activate <=> base.activate;

    min-height: entry.is-separator ? 9px : max(28px, base.min-height);
    max-height: entry.is-separator ? 9px : base.max-height;

    HorizontalLayout {
        padding-top: entry.is-separator ? 4px : 0px;
        padding-bottom: entry.is-separator ? 4px : 0px;

        base := MenuItemBase {
            default-foreground: FluentPalette.foreground;
            alternate-foreground: FluentPalette.text-secondary;
            current-foreground: #ffffff;
            current-background: light ? #2b6fe0 : #3d8bfd;
            separator-color: light ? #c5ccd8 : #2e3542;
            border-radius: 0px;
            horizontal-padding: 12px;
            spacing: 8px;
            sub-menu-icon: @image-url("_arrow_forward.svg");
            icon-size: 12px;
        }
    }
}
